---
import { tinaField } from "@tinacms/astro/tina-field";
import R2Picture from "./R2Picture.astro";

// Contact Sections
import ContactFormBlock from "./sections/contact/ContactBlock.astro";
import EditorialAccordion from "./sections/editorial/Accordion.astro";
import EditorialBanner from "./sections/editorial/Banner.astro";
import EditorialCarousel from "./sections/editorial/Carousel.astro";
import EditorialCopy from "./sections/editorial/Copy.astro";
import EditorialCta from "./sections/editorial/Cta.astro";
// Editorial Sections
import EditorialHero from "./sections/editorial/Hero.astro";
import EditorialInstagram from "./sections/editorial/Instagram.astro";
import EditorialMission from "./sections/editorial/Mission.astro";
import RichText from "./sections/editorial/RichText.astro";
import EditorialRows from "./sections/editorial/Rows.astro";
import EditorialShowcase from "./sections/editorial/Showcase.astro";
import ProjectCollaborators from "./sections/projects/Collaborators.astro";
// Project Sections
import ProjectDetails from "./sections/projects/Details.astro";

// Type definition for our block
interface Props {
	block: any;
	index: number;
	parentData: any;
}

const { block, index, parentData } = Astro.props;
const template = block._template;
const supportedTemplates = new Set([
	"accordion",
	"banner",
	"callout",
	"carousel",
	"credits",
	"details",
	"feed",
	"form",
	"gallery",
	"hero",
	"list",
	"media",
	"showcase",
	"statement",
	"text",
]);

if (typeof template !== "string" || !supportedTemplates.has(template)) {
	throw new Error(
		`Unsupported content block template at index ${index}: ${String(template)}`,
	);
}

function mediaId(value?: string | null) {
	return (value || "")
		.replace(/^https:\/\/media\.senshac\.com\/images\//, "")
		.replace(/^\/?images\//, "")
		.replace(
			/\/(?:320|412|480|640|768|1024|1200|1280|1920)\.(?:avif|webp)$/,
			"",
		)
		.replace(/\.[^.]+$/, "");
}
---

<div data-tina-field={tinaField(block)}>
  {template === 'banner' && <EditorialBanner {...block} tinaData={block} eager={index === 0} />}
  {template === 'hero' && <EditorialHero {...block} tinaData={block} eager={index === 0} />}
  {template === 'text' && !['brief', 'concept', 'strategy'].includes(block.variant) && <EditorialCopy {...block} tinaData={block} />}
  {template === 'accordion' && <EditorialAccordion {...block} tinaData={block} />}
  {template === 'list' && <EditorialRows {...block} tinaData={block} />}
  {template === 'callout' && <EditorialCta {...block} tinaData={block} />}
  {template === 'showcase' && (
    <EditorialShowcase
      {...block}
      items={block.items}
      tinaData={block}
    />
  )}
  {template === 'statement' && <EditorialMission {...block} />}
  {template === 'carousel' && <EditorialCarousel {...block} eagerFirst={index === 0} />}
  {template === 'feed' && <EditorialInstagram {...block} tinaData={block} />}
  {template === 'gallery' && block.images && (
    <section class="max-w-7xl mx-auto px-4 my-16">
      <div class={`grid gap-4 grid-cols-1 md:grid-cols-${block.cols || 2}`}>
        {block.images.map((img: any, imageIndex: number) => (
          <R2Picture id={mediaId(img.mediaId)} alt={img.alt} class="w-full h-auto object-cover aspect-square md:aspect-auto" eager={index === 0 && imageIndex === 0} mediaSlot="grid" />
        ))}
      </div>
    </section>
  )}

  {template === 'media' && block.variant === 'banner' && (
    <div class="w-full aspect-video overflow-hidden">
      <R2Picture
        id={mediaId(block.mediaId)}
        alt={block.alt}
		class="w-full h-full object-cover"
		eager={index === 0}
		mediaSlot="full"
      />
    </div>
  )}
  {template === 'form' && <ContactFormBlock {...block} tinaData={block} />}
  {template === 'details' && <ProjectDetails {...block} eager={index === 0} />}
  {template === 'text' && ['brief', 'concept', 'strategy'].includes(block.variant) && (
    <section class:list={['py-16 md:py-24 max-w-7xl mx-auto px-4', { 'bg-gray-50': block.variant === 'concept' }]}>
      <h2 class="text-3xl font-bold mb-6">{block.title}</h2>
      <div class="text-lg text-gray-600 mb-12 [[prose-p:my-2_p]:my-2_p]:my-2">
        <RichText content={block.body} />
      </div>
    </section>
  )}
  {template === 'credits' && <ProjectCollaborators list={block.list} />}
  {template === 'media' && block.variant === 'full' && (
    <div class="w-full mt-16">
      <R2Picture id={mediaId(block.mediaId)} alt={block.alt} class="w-full h-auto" mediaSlot="full" />
    </div>
  )}

</div>
