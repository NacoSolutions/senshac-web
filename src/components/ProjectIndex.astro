---
interface Project {
  title: string;
  slug: string;
  description: string;
  featured: boolean;
  tags: string[];
}

const { projects } = Astro.props as { projects: Project[] };
---
<section class="projects-surface" id="main" aria-labelledby="projects-title">
  <p class="eyebrow">Selected work</p>
  <h1 id="projects-title">Projects</h1>
  <div class="project-grid">
    {projects.map((project) => (
      <article class="project-card">
        <p class="project-number">{project.featured ? 'Featured' : 'Project'}</p>
        <h2><a href={`/projects/${project.slug}/`}>{project.title}</a></h2>
        <p>{project.description}</p>
        <ul aria-label={`${project.title} categories`}>
          {project.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>
<style>
  .projects-surface { padding: clamp(4rem, 12vw, 10rem) clamp(1.25rem, 10vw, 10rem) 6rem; }
  .eyebrow, .project-number { color: #e85d3f; font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  h1 { margin: 0 0 4rem; font-size: clamp(3.5rem, 11vw, 9rem); line-height: .9; letter-spacing: -.08em; }
  .project-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 3rem 2rem; }
  .project-card { border-top: 1px solid #ccc; padding-top: 1rem; }
  .project-number { margin: 0; }
  h2 { margin: 1.5rem 0 1rem; font-size: clamp(1.75rem, 4vw, 3rem); letter-spacing: -.05em; }
  h2 a { text-decoration: none; }
  h2 a:hover, h2 a:focus-visible { color: #e85d3f; }
  .project-card > p:not(.project-number) { max-width: 28rem; line-height: 1.5; }
  ul { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; list-style: none; font-size: .8rem; }
  li { border: 1px solid #ccc; border-radius: 999px; padding: .35rem .7rem; }
</style>
