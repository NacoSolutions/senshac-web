---
import { tinaField } from "@tinacms/astro/tina-field";
import type { SiteConfigQuery } from "../../tina/__generated__/types";
import { getSiteConfig } from "../utils/site-config";
// src/components/Header.astro
import { getTranslations, type Translations } from "../utils/translations";
import { resolvePageChromeFieldTarget } from "../utils/page-chrome.mjs";
import BrandMark from "./BrandMark.astro";

type Appearance = "transparent-adaptive" | "transparent-light" | "transparent-dark" | "opaque-light" | "opaque-dark";
type ChromePart = { mode?: "fixed" | "scrolling"; atFinal?: Appearance; scrolling?: Appearance };

interface Props {
	lang: string;
	headerStyle?: "default" | "transparent";
	translations?: Translations;
	siteData?: SiteConfigQuery["siteConfig"];
	chrome?: { header?: ChromePart };
	pageData?: Record<string, unknown>;
	pageChromePath?: string;
}

const {
	lang,
	headerStyle = "default",
	translations: propTranslations,
	siteData: propSiteData,
	chrome: propChrome,
	pageData,
	pageChromePath,
} = Astro.props;
const currentPath = Astro.url.pathname;

const isTransparent = headerStyle === "transparent";
const header = propChrome?.header;
const mode = header?.mode ?? "fixed";
const scrollingAppearance = header?.scrolling ?? (isTransparent ? "transparent-adaptive" : "opaque-light");
const finalAppearance = header?.atFinal ?? "opaque-light";
const appearanceClasses: Record<Appearance, string> = {
	"transparent-adaptive": "bg-transparent text-white",
	"transparent-light": "bg-transparent text-white",
	"transparent-dark": "bg-transparent text-gray-900",
	"opaque-light": "bg-white/95 text-gray-900 backdrop-blur-sm border-b border-gray-100",
	"opaque-dark": "bg-black/95 text-white backdrop-blur-sm border-b border-white/20",
};
const initialAppearance = appearanceClasses[scrollingAppearance];
const finalAppearanceClasses = appearanceClasses[finalAppearance];
const pageChromeTarget = resolvePageChromeFieldTarget(pageData, pageChromePath, "header");
const lightForegroundAppearances = ["transparent-adaptive", "transparent-light", "opaque-dark"];
const controlAppearance = (appearance: string) =>
	lightForegroundAppearances.includes(appearance)
		? "text-white hover:opacity-80"
		: "text-gray-800 hover:text-black";

const t = propTranslations ?? (await getTranslations(lang));
const site = (propSiteData ?? (await getSiteConfig())) as any;

const navItems = (t.nav.links || []).map((item: any) => ({
	href: item.href,
	label: item.label,
}));

// Infer languages from locales config
const languages = (site.locales || []).map((code: string | null) => ({
	code,
	label: code?.toUpperCase() || "",
}));

const getLocalizedPath = (targetLang: string) => {
	return currentPath.replace(`/${lang}`, `/${targetLang}`);
};
---

<div
  x-data={`{
    langOpen: false,
    scrolled: false,
    isTransparent: ${isTransparent},
    appearance: '${scrollingAppearance}',
    scrollingAppearance: '${scrollingAppearance}',
    finalAppearance: '${finalAppearance}'
  }`}
  x-init="window.addEventListener('scroll', () => { scrolled = window.scrollY > 50 })"
>
  <header
    class:list={[mode === "fixed" ? "fixed" : "relative", "top-0 left-0 right-0 z-50 transition-all duration-300"]}
    data-header-style={headerStyle}
    data-chrome-mode={mode}
    data-chrome-at-final={finalAppearance}
    data-chrome-scrolling={scrollingAppearance}
    data-tina-field={pageChromeTarget ? tinaField(pageChromeTarget.data, pageChromeTarget.field) : undefined}
    x-bind:class={`appearance === '${scrollingAppearance}' ? '${initialAppearance}' : '${finalAppearanceClasses}'`}
    x-effect="appearance = scrolled ? finalAppearance : scrollingAppearance"
  >
    <nav aria-label={t.nav.menu} class="w-full px-4 md:px-8 min-h-20 py-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 lg:h-20 lg:flex-nowrap lg:py-0">
      <!-- Logo -->
      <a href={`/${lang}/`} class="flex-shrink-0" aria-label="Senshac home">
        <BrandMark kind="wordmark" size="header" />
      </a>

      <ul class="order-3 flex w-full list-none items-center justify-between gap-3 overflow-x-auto p-0 lg:order-2 lg:mx-auto lg:w-auto lg:gap-10 xl:gap-12">
        {navItems.map((item: any, index: number) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "whitespace-nowrap text-[0.6875rem] uppercase tracking-[0.04em] transition-colors lg:text-xs lg:tracking-[0.16em]",
                currentPath.startsWith(item.href) && "font-medium",
              ]}
              x-bind:class={`appearance === '${scrollingAppearance}' ? '${controlAppearance(scrollingAppearance)}' : '${controlAppearance(finalAppearance)}'`}
              aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
              data-tina-field={t.nav.links?.[index] ? tinaField(t.nav.links[index], "href") : undefined}
            >
              <span data-tina-field={t.nav.links?.[index] ? tinaField(t.nav.links[index], "label") : undefined}>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <!-- Right side controls -->
      <div class="order-2 ml-auto flex items-center gap-4 lg:order-3 lg:ml-0">
        <!-- Language Dropdown -->
        <div class="relative" x-on:click.away="langOpen = false">
          <button
            type="button"
            class="flex items-center gap-1 text-sm uppercase tracking-wider transition-colors"
            x-bind:class={`appearance === '${scrollingAppearance}' ? '${controlAppearance(scrollingAppearance)}' : '${controlAppearance(finalAppearance)}'`}
            x-on:click="langOpen = !langOpen"
            aria-label={`${t.accessibility.selectLanguage}, current: ${lang.toUpperCase()}`}
            data-tina-field={tinaField(t.accessibility, "selectLanguage")}
          >
            <span data-tina-field={tinaField(site, "locales", site.locales.indexOf(lang))}>{lang.toUpperCase()}</span>
            <span class="i-lucide-chevron-down w-3 h-3 transition-transform" x-bind:class="langOpen && 'rotate-180'" />
          </button>

          <div
            class="absolute right-0 top-full mt-2 bg-white border border-gray-200 rounded shadow-lg py-1 min-w-16"
            x-show="langOpen"
            x-transition:enter="transition ease-out duration-100"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-75"
            x-transition:leave-start="opacity-100 scale-100"
            x-transition:leave-end="opacity-0 scale-95"
            x-cloak
          >
            {languages.filter((l: any) => l.code !== lang).map((l: any) => (
              <a
                href={getLocalizedPath(l.code)}
                class="block px-4 py-2 text-sm uppercase text-gray-600 hover:bg-gray-50 hover:text-black transition-colors"
              >
                <span data-tina-field={tinaField(site, "locales", site.locales.indexOf(l.code))}>{l.label}</span>
              </a>
            ))}
          </div>
        </div>


      </div>
    </nav>
  </header>

</div>
<style>
  [x-cloak] {
    display: none !important;
  }
</style>
