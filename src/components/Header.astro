---
import { tinaField } from "@tinacms/astro/tina-field";
import type { SiteConfigQuery } from "../../tina/__generated__/types";
import { getSiteConfig } from "../utils/site-config";
// src/components/Header.astro
import { getTranslations, type Translations } from "../utils/translations";
import { resolvePageChromeFieldTarget } from "../utils/page-chrome.mjs";
import BrandMark from "./BrandMark.astro";

type Appearance = "transparent-adaptive" | "transparent-light" | "transparent-dark" | "opaque-light" | "opaque-dark";
type ChromePart = { mode?: "fixed" | "scrolling"; atFinal?: Appearance; scrolling?: Appearance };

interface Props {
	lang: string;
	headerStyle?: "default" | "transparent";
	translations?: Translations;
	siteData?: SiteConfigQuery["siteConfig"];
	chrome?: { header?: ChromePart };
	pageData?: Record<string, unknown>;
	pageChromePath?: string;
}

const {
	lang,
	headerStyle = "default",
	translations: propTranslations,
	siteData: propSiteData,
	chrome: propChrome,
	pageData,
	pageChromePath,
} = Astro.props;
const currentPath = Astro.url.pathname;

const isTransparent = headerStyle === "transparent";
const header = propChrome?.header;
const mode = header?.mode ?? "fixed";
const scrollingAppearance = header?.scrolling ?? (isTransparent ? "transparent-adaptive" : "opaque-light");
const rawFinalAppearance = header?.atFinal ?? "opaque-light";
const finalAppearance: Appearance =
	mode === "fixed" && rawFinalAppearance.startsWith("transparent-")
		? "opaque-light"
		: rawFinalAppearance;
const appearanceClasses: Record<Appearance, string> = {
	"transparent-adaptive": "bg-transparent text-white",
	"transparent-light": "bg-transparent text-white",
	"transparent-dark": "bg-transparent text-gray-900",
	"opaque-light": "bg-white/95 text-gray-900 backdrop-blur-sm border-b border-gray-100",
	"opaque-dark": "bg-black/95 text-white backdrop-blur-sm border-b border-white/20",
};
const initialAppearance = appearanceClasses[scrollingAppearance];
const finalAppearanceClasses = appearanceClasses[finalAppearance];
const pageChromeTarget = resolvePageChromeFieldTarget(pageData, pageChromePath, "header");
const lightForegroundAppearances = ["transparent-adaptive", "transparent-light", "opaque-dark"];
const controlAppearance = (appearance: string) =>
	lightForegroundAppearances.includes(appearance)
		? "text-white hover:opacity-75"
		: "text-gray-800 hover:text-black";
const langMenuTheme = (appearance: string) =>
	lightForegroundAppearances.includes(appearance)
		? "lang-menu--dark"
		: "lang-menu--light";

const t = propTranslations ?? (await getTranslations(lang));
const site = (propSiteData ?? (await getSiteConfig())) as any;

const navItems = (t.nav.links || []).map((item: any) => ({
	href: item.href,
	label: item.label,
}));

// Infer languages from locales config
const languages = (site.locales || []).map((code: string | null) => ({
	code,
	label: code?.toUpperCase() || "",
}));

const getLocalizedPath = (targetLang: string) => {
	return currentPath.replace(`/${lang}`, `/${targetLang}`);
};
---

<div
  x-data={`{
    langOpen: false,
    scrolled: false,
    isTransparent: ${isTransparent},
    appearance: '${scrollingAppearance}',
    scrollingAppearance: '${scrollingAppearance}',
    finalAppearance: '${finalAppearance}'
  }`}
  x-init="scrolled = window.scrollY > 50; window.addEventListener('scroll', () => { scrolled = window.scrollY > 50 }, { passive: true })"
>
  <header
    class:list={[mode === "fixed" ? "fixed" : "relative", "top-0 left-0 right-0 z-50 transition-all duration-300"]}
    data-header-style={headerStyle}
    data-chrome-mode={mode}
    data-chrome-at-final={finalAppearance}
    data-chrome-scrolling={scrollingAppearance}
    data-tina-field={pageChromeTarget ? tinaField(pageChromeTarget.data, pageChromeTarget.field) : undefined}
    x-bind:class={`appearance === '${scrollingAppearance}' ? '${initialAppearance}' : '${finalAppearanceClasses}'`}
    x-effect="appearance = scrolled ? finalAppearance : scrollingAppearance"
  >
    <nav
      aria-label={t.nav.menu}
      data-homepage-nav={currentPath === "/" + lang + "/" || currentPath === "/" + lang ? "true" : undefined}
      class="editorial-shell min-h-20 py-2 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 lg:grid lg:grid-cols-12 lg:gap-6 lg:items-center lg:h-20 lg:py-0"
    >
      <!-- Logo -->
      <a href={`/${lang}/`} class="flex-shrink-0 lg:col-[1/3] lg:row-start-1 lg:justify-self-start" aria-label="Senshac home">
        <BrandMark kind="wordmark" size="header" />
      </a>

      <ul class="order-3 flex w-full list-none items-center justify-between gap-4 overflow-x-auto p-0 sm:gap-6 lg:order-2 lg:col-[6/11] lg:row-start-1 lg:w-full lg:justify-between lg:gap-6 lg:overflow-visible">
        {navItems.map((item: any, index: number) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "whitespace-nowrap text-xs uppercase tracking-[0.06em] transition-colors lg:text-sm lg:tracking-[0.1em]",
                currentPath.startsWith(item.href) && "font-medium",
              ]}
              x-bind:class={`appearance === '${scrollingAppearance}' ? '${controlAppearance(scrollingAppearance)}' : '${controlAppearance(finalAppearance)}'`}
              aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
              data-tina-field={t.nav.links?.[index] ? tinaField(t.nav.links[index], "href") : undefined}
            >
              <span data-tina-field={t.nav.links?.[index] ? tinaField(t.nav.links[index], "label") : undefined}>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <!-- Right side controls -->
      <div class="order-2 ml-auto flex items-center gap-4 lg:order-3 lg:col-[12/13] lg:row-start-1 lg:ml-0 lg:justify-self-end">
        <!-- Language Dropdown -->
        <div
          class="lang-dropdown"
          x-on:click.away="langOpen = false"
          x-on:keydown.escape.window="langOpen = false"
        >
          <button
            type="button"
            class="lang-trigger"
            x-bind:class={`appearance === '${scrollingAppearance}' ? '${controlAppearance(scrollingAppearance)}' : '${controlAppearance(finalAppearance)}'`}
            x-on:click="langOpen = !langOpen"
            aria-haspopup="true"
            aria-expanded="false"
            x-bind:aria-expanded="langOpen ? 'true' : 'false'"
            aria-controls="lang-menu"
            aria-label={`${t.accessibility.selectLanguage}, current: ${lang.toUpperCase()}`}
            data-tina-field={tinaField(t.accessibility, "selectLanguage")}
          >
            <span data-tina-field={tinaField(site, "locales", site.locales.indexOf(lang))}>{lang.toUpperCase()}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div
            id="lang-menu"
            role="menu"
            class="lang-menu"
            x-bind:class={`appearance === '${scrollingAppearance}' ? '${langMenuTheme(scrollingAppearance)}' : '${langMenuTheme(finalAppearance)}'`}
            x-show="langOpen"
            x-transition:enter="transition ease-out duration-100"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-75"
            x-transition:leave-start="opacity-100 scale-100"
            x-transition:leave-end="opacity-0 scale-95"
            x-cloak
          >
            {languages.map((l: any) => (
              <a
                href={getLocalizedPath(l.code)}
                role="menuitem"
                aria-current={l.code === lang ? "true" : undefined}
                class="lang-menu__item"
              >
                <span data-tina-field={tinaField(site, "locales", site.locales.indexOf(l.code))}>{l.label}</span>
              </a>
            ))}
          </div>
        </div>


      </div>
    </nav>
  </header>

</div>
<style>
  [x-cloak] {
    display: none !important;
  }

  .lang-dropdown {
    position: relative;
  }

  .lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: 0;
    padding: 0.25rem 0;
    font: inherit;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s, color 0.2s;
  }

  .lang-trigger svg {
    width: 0.75rem;
    height: 0.75rem;
    transition: transform 0.2s;
  }

  .lang-trigger[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.45rem);
    width: max-content;
    padding: 0.2rem 0;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 20;
  }

  .lang-menu--dark {
    background: rgba(13, 13, 13, 0.45);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.16);
  }

  .lang-menu--light {
    background: rgba(255, 255, 255, 0.78);
    color: #111827;
    border: 1px solid rgba(17, 24, 39, 0.14);
  }

  .lang-menu__item {
    display: block;
    width: 100%;
    padding: 0.3rem 0.65rem;
    text-align: center;
    font: inherit;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }

  .lang-menu--dark .lang-menu__item {
    color: rgba(255, 255, 255, 0.72);
  }

  .lang-menu--dark .lang-menu__item:hover,
  .lang-menu--dark .lang-menu__item:focus-visible {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    outline: none;
  }

  .lang-menu--dark .lang-menu__item[aria-current="true"] {
    font-weight: 600;
    color: #fff;
  }

  .lang-menu--light .lang-menu__item {
    color: rgba(17, 24, 39, 0.72);
  }

  .lang-menu--light .lang-menu__item:hover,
  .lang-menu--light .lang-menu__item:focus-visible {
    background: rgba(17, 24, 39, 0.08);
    color: #000;
    outline: none;
  }

  .lang-menu--light .lang-menu__item[aria-current="true"] {
    font-weight: 600;
    color: #000;
  }
</style>
