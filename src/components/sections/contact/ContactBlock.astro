---
import { getSiteConfig } from "../../../utils/site-config";
import { tinaField } from "@tinacms/astro/tina-field";
// src/components/sections/contact/ContactBlock.astro
import ContactForm from "../../ContactForm.astro";
import R2Picture from "../../R2Picture.astro";

interface Props {
	heading?: string;
	subheading?: string;
	mediaId?: string;
	lang?: string;
	tinaData?: Record<string, unknown>;
}

const { heading, subheading, mediaId } = Astro.props;
const tinaData = (Astro.props.tinaData ?? Astro.props) as Record<string, unknown>;
const lang = Astro.params.lang || "es";
const site = await getSiteConfig();
const resolvedMediaId =
	!mediaId || mediaId.includes("senshac-contact-banner")
		? "reference-intake/contact/background"
		: mediaId;
const whatsappNumber = (site.contact?.phoneLink || site.contact?.phone || "").replace(/\D/g, "");
const socialLinks = (site.socialLinks || []).filter(
	(link: { name?: string } | null) => link?.name?.toLowerCase() !== "houzz",
);
const searchParams = Astro.url.searchParams;
const initialMode =
	searchParams.has("situation") ||
	searchParams.has("service") ||
	searchParams.get("mode") === "guided" ||
	searchParams.has("path") ||
	searchParams.has("package")
		? "guided"
		: "direct";
const initialExpanded = Boolean(
	initialMode === "guided" &&
		searchParams.get("situation") &&
		searchParams.get("service") &&
		!searchParams.has("path") &&
		!searchParams.has("package"),
);
---

<section
  class="contact-block relative w-full min-h-[calc(100vh-5rem)] overflow-clip py-24 md:py-32"
  data-contact-mode={initialMode}
  data-form-expanded={initialExpanded ? "true" : "false"}
>
  <div class="contact-block__backdrop">
    <div class="contact-block__backdrop-media">
      <R2Picture
        id={resolvedMediaId}
        alt=""
        class="w-full h-full object-cover"
        eager
        mediaSlot="full"
        data-tina-field={tinaField(tinaData, "mediaId")}
      />
    </div>
    <div class="absolute inset-0" style="background: rgba(0, 0, 0, 0.49);" aria-hidden="true"></div>
  </div>

  <div class="relative z-10 editorial-shell-wide">
    <div class="contact-block__content grid grid-cols-1">
      <div class="contact-block__grid editorial-grid-12 items-start">
        <!-- Left Rail (cols 1-4): Heading + Contact Details -->
        <div class="editorial-rail-left text-white">
          {heading && (
            <h1
              class="m-0 font-sans font-semibold uppercase text-white text-[clamp(2.25rem,3.6vw,3.75rem)] leading-[1.05] tracking-[0.01em]"
              data-tina-field={tinaField(tinaData, "heading")}
            >
              {heading}
            </h1>
          )}

          <div class="mt-10 md:mt-16 flex flex-col items-start gap-2.5 font-sans font-semibold text-white text-[clamp(1.125rem,1.6vw,1.625rem)] leading-[1.35]">
            {site.contact?.email && (
              <a
                href={`mailto:${site.contact.email}`}
                class="contact-link w-max text-white no-underline hover:opacity-75 transition-opacity"
              >
                <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="m22 7-10 7L2 7" />
                </svg>
                <span data-tina-field={tinaField(site.contact, "email")}>{site.contact.email}</span>
              </a>
            )}
            {site.contact?.phone && (
              <a
                href={`tel:${site.contact.phoneLink || site.contact.phone.replace(/\s/g, "")}`}
                class="contact-link w-max whitespace-nowrap text-white no-underline hover:opacity-75 transition-opacity"
              >
                <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                <span data-tina-field={tinaField(site.contact, "phone")}>{site.contact.phone}</span>
              </a>
            )}
            {whatsappNumber && (
              <a
                href={`https://wa.me/${whatsappNumber}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="WhatsApp Sens*hac"
                class="contact-link w-max whitespace-nowrap text-white no-underline hover:opacity-75 transition-opacity"
              >
                <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" />
                  <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" />
                </svg>
                <span>Sens*hac</span>
                <svg class="contact-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17L17 7" />
                  <path d="M7 7h10v10" />
                </svg>
              </a>
            )}
          </div>

          {socialLinks.length > 0 && (
            <div class="mt-8 md:mt-10 flex flex-col items-start gap-2 font-sans font-medium text-white/90 text-[clamp(1rem,1.25vw,1.25rem)] leading-[1.35]">
              {socialLinks.map((link: any, index: number) => {
                const socialKey = link?.name?.toLowerCase() ?? "";
                return (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={link.name}
                    class="contact-link w-max whitespace-nowrap text-current no-underline hover:opacity-75 transition-opacity"
                  >
                    {socialKey.includes("instagram") && (
                      <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                      </svg>
                    )}
                    {socialKey.includes("linkedin") && (
                      <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                        <rect x="2" y="9" width="4" height="12" />
                        <circle cx="4" cy="4" r="2" />
                      </svg>
                    )}
                    {socialKey.includes("pinterest") && (
                      <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M8 20l4-9" />
                        <path d="M10.7 14c.437 1.263 1.43 2 2.55 2 2.071 0 3.75-1.554 3.75-4a5 5 0 1 0-9.7 1.7" />
                      </svg>
                    )}
                    <span data-tina-field={tinaField(site, "socialLinks", index)}>{link.name}</span>
                    <svg class="contact-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17L17 7" />
                      <path d="M7 7h10v10" />
                    </svg>
                  </a>
                );
              })}
            </div>
          )}
        </div>

        <!-- Right Rail (cols 6-12): Headline + Contact Form Card -->
        <div class="editorial-rail-main">
          {subheading && (
            <p
              class="m-0 mb-8 font-sans font-semibold text-white text-[clamp(1.75rem,3vw,3rem)] leading-[1.1]"
              data-tina-field={tinaField(tinaData, "subheading")}
            >
              {subheading}
            </p>
          )}

          <div class="contact-block__card rounded-[2rem] bg-white/90 backdrop-blur-[6px] p-6 sm:p-8 lg:p-10 text-black shadow-sm">
            <ContactForm lang={lang} />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const sections = document.querySelectorAll('.contact-block');
    for (const section of sections) {
      if (section.dataset.contactZoomBound === 'true') continue;
      section.dataset.contactZoomBound = 'true';
      section.addEventListener('senshac:contact-state', (event) => {
        const detail = event.detail || {};
        if (detail.mode) {
          section.dataset.contactMode = detail.mode;
        }
        if (typeof detail.expanded === 'boolean') {
          section.dataset.formExpanded = detail.expanded ? 'true' : 'false';
        }
      });
    }
  })();
</script>

<style>
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .contact-icon {
    width: 0.95em;
    height: 0.95em;
    flex-shrink: 0;
    opacity: 0.78;
  }

  .contact-arrow {
    width: 0.85em;
    height: 0.85em;
    flex-shrink: 0;
    opacity: 0.78;
  }

  .contact-block__backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    overflow: clip;
    contain: paint;
  }

  .contact-block__backdrop-media {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    transform: translate3d(0, 0, 0) scale(1);
    transition: transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
    backface-visibility: hidden;
  }

  .contact-block__backdrop-media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .contact-block[data-contact-mode="guided"] .contact-block__backdrop-media {
    transform: translate3d(0, 0, 0) scale(1.04);
  }

  .contact-block[data-form-expanded="true"] .contact-block__backdrop-media {
    transform: translate3d(0, 0, 0) scale(1.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-block__backdrop-media {
      transition: none;
    }
  }
</style>
