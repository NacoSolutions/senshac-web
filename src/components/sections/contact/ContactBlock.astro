---
import { getSiteConfig } from "../../../utils/site-config";
import { tinaField } from "@tinacms/astro/tina-field";
// src/components/sections/contact/ContactBlock.astro
import ContactForm from "../../ContactForm.astro";
import R2Picture from "../../R2Picture.astro";

interface Props {
	heading?: string;
	subheading?: string;
	mediaId?: string;
	lang?: string;
	tinaData?: Record<string, unknown>;
}

const { heading, subheading, mediaId } = Astro.props;
const tinaData = (Astro.props.tinaData ?? Astro.props) as Record<string, unknown>;
const lang = Astro.params.lang || "es";
const site = await getSiteConfig();
const resolvedMediaId =
	!mediaId || mediaId.includes("senshac-contact-banner")
		? "reference-intake/contact/background"
		: mediaId;
const whatsappNumber = (site.contact?.phoneLink || site.contact?.phone || "").replace(/\D/g, "");
const searchParams = Astro.url.searchParams;
const initialMode =
	searchParams.has("situation") ||
	searchParams.has("service") ||
	searchParams.get("mode") === "guided" ||
	searchParams.has("path") ||
	searchParams.has("package")
		? "guided"
		: "direct";
const initialExpanded = Boolean(
	initialMode === "guided" &&
		searchParams.get("situation") &&
		searchParams.get("service") &&
		!searchParams.has("path") &&
		!searchParams.has("package"),
);
---

<section
  class="contact-block relative w-full min-h-[calc(100vh-5rem)] overflow-hidden py-24 md:py-32"
  data-contact-mode={initialMode}
  data-form-expanded={initialExpanded ? "true" : "false"}
>
  <div class="contact-block__backdrop absolute inset-0 overflow-hidden">
    <div class="contact-block__backdrop-media absolute inset-0">
      <R2Picture
        id={resolvedMediaId}
        alt=""
        class="w-full h-full object-cover"
        eager
        mediaSlot="full"
        data-tina-field={tinaField(tinaData, "mediaId")}
      />
    </div>
    <div class="absolute inset-0" style="background: rgba(0, 0, 0, 0.49);" aria-hidden="true"></div>
  </div>

  <div class="relative z-10 editorial-shell-wide">
    <div class="contact-block__content grid grid-cols-1">
      <div class="contact-block__grid editorial-grid-12 items-start">
        <!-- Left Rail (cols 1-4): Heading + Contact Details -->
        <div class="editorial-rail-left text-white">
          {heading && (
            <h1
              class="m-0 font-sans font-semibold uppercase text-white text-[clamp(2.25rem,3.6vw,3.75rem)] leading-[1.05] tracking-[0.01em]"
              data-tina-field={tinaField(tinaData, "heading")}
            >
              {heading}
            </h1>
          )}

          <div class="mt-10 md:mt-16 flex flex-col gap-1.5 font-sans font-semibold text-white text-[clamp(1.125rem,1.6vw,1.625rem)] leading-[1.35]">
            {site.contact?.email && (
              <a
                href={`mailto:${site.contact.email}`}
                class="w-max text-white no-underline hover:opacity-75 transition-opacity"
              >
                <span data-tina-field={tinaField(site.contact, "email")}>{site.contact.email}</span>
              </a>
            )}
            {site.contact?.phone && (
              <a
                href={`tel:${site.contact.phoneLink || site.contact.phone.replace(/\s/g, "")}`}
                class="w-max text-white no-underline hover:opacity-75 transition-opacity"
              >
                <span data-tina-field={tinaField(site.contact, "phone")}>{site.contact.phone}</span>
              </a>
            )}
            {whatsappNumber && (
              <a
                href={`https://wa.me/${whatsappNumber}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="WhatsApp Sens*hac"
                class="w-max text-white no-underline hover:opacity-75 transition-opacity"
              >
                Sens*hac
              </a>
            )}
          </div>
        </div>

        <!-- Right Rail (cols 6-12): Headline + Contact Form Card -->
        <div class="editorial-rail-main">
          {subheading && (
            <p
              class="m-0 mb-8 font-sans font-semibold text-white text-[clamp(1.75rem,3vw,3rem)] leading-[1.1]"
              data-tina-field={tinaField(tinaData, "subheading")}
            >
              {subheading}
            </p>
          )}

          <div class="contact-block__card rounded-[2rem] bg-white/85 backdrop-blur-md p-6 sm:p-8 lg:p-10 text-black shadow-sm">
            <ContactForm lang={lang} />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const sections = document.querySelectorAll('.contact-block');
    for (const section of sections) {
      if (section.dataset.contactZoomBound === 'true') continue;
      section.dataset.contactZoomBound = 'true';
      section.addEventListener('senshac:contact-state', (event) => {
        const detail = event.detail || {};
        if (detail.mode) {
          section.dataset.contactMode = detail.mode;
        }
        if (typeof detail.expanded === 'boolean') {
          section.dataset.formExpanded = detail.expanded ? 'true' : 'false';
        }
      });
    }
  })();
</script>

<style>
  .contact-block__backdrop-media {
    transform: scale(1);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .contact-block[data-contact-mode="guided"] .contact-block__backdrop-media {
    transform: scale(1.03);
  }

  .contact-block[data-form-expanded="true"] .contact-block__backdrop-media {
    transform: scale(1.07);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-block__backdrop-media {
      transition: none;
    }
  }
</style>
