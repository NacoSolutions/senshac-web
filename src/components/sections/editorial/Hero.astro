---
import { tinaField } from "@tinacms/astro/tina-field";
import MediaPlaceholder from "./MediaPlaceholder.astro";
import RichText from "./RichText.astro";

interface Props {
	title?: string;
	intro?: any;
	ctaText?: string;
	ctaLink?: string;
	mediaId?: string;
	imageAlt?: string;
	mediaType?: "image" | "video";
	placeholderLabel?: string;
	objectFit?: "cover" | "contain";
	eager?: boolean;
	tinaData?: any;
}

const {
	title,
	intro,
	ctaText,
	ctaLink,
	mediaId,
	imageAlt,
	mediaType = "image",
	placeholderLabel,
	objectFit = "cover",
	eager = false,
	tinaData,
} = Astro.props;
---

<section class="home-hero" aria-labelledby={title ? "home-hero-title" : undefined}>
  <div class="home-hero__media">
    <MediaPlaceholder
      mediaId={mediaId}
      alt={imageAlt}
      kind={mediaType || 'image'}
      label={placeholderLabel}
      aspect="wide"
      objectFit={objectFit}
      eager={eager}
      variant="banner"
      mediaSlot="full"
      fieldMarker={tinaField(tinaData, 'mediaId')}
    />
  </div>
  <div class="home-hero__scrim" aria-hidden="true"></div>
  <div class="editorial-shell home-hero__content">
    <div class="home-hero__copy">
      {intro && (
        <div data-tina-field={tinaField(tinaData, 'intro')} class="editorial-lede home-hero__intro" x-reveal>
          <RichText content={intro} />
        </div>
      )}
      <h2 id={title ? "home-hero-title" : undefined} data-tina-field={tinaField(tinaData, 'title')} class="editorial-display home-hero__title">{title}</h2>

    </div>
  </div>
{ctaText && ctaLink && <a data-tina-field={tinaField(tinaData, 'ctaLink')} class="editorial-link home-hero__cta" href={ctaLink}><span data-tina-field={tinaField(tinaData, 'ctaText')}>{ctaText}</span></a>}
</section>

<style>
  .home-hero {
    position: relative;
    min-height: min(100svh, 60rem);
    overflow: hidden;
    background: #fff;
    color: #fff;
  }

  .home-hero__media {
    position: absolute;
    inset: 0 0 2.5rem;
    display: flex;
    overflow: hidden;
  }

  .home-hero__media :global(> div) {
    height: 100%;
    min-height: 0;
    aspect-ratio: auto;
  }

  .home-hero__media :global(picture),
  .home-hero__media :global(video) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .home-hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero__scrim {
    position: absolute;
    inset: 0 0 2.5rem;
    background: linear-gradient(180deg, rgb(0 0 0 / 8%) 30%, rgb(0 0 0 / 64%) 100%);
  }

  .home-hero__content {
    position: relative;
    display: flex;
    min-height: calc(min(100svh, 60rem) - 2.5rem);
    align-items: flex-end;
    padding-top: clamp(7rem, 14vh, 11rem);
    padding-bottom: calc(clamp(3rem, 8vh, 7rem) + 2.5rem);
  }

  .home-hero__copy {
    width: 100%;
    max-width: 34rem;
    margin-left: auto;
    text-align: right;
  }

  .home-hero__title {
    max-width: 17ch;
    margin: 0 0 0 auto;
    font-size: clamp(2.25rem, 3.8vw, 3.25rem);
    font-weight: 500;
    line-height: 1.02;
  }

  .home-hero__intro {
    max-width: 31rem;
    margin: 0 0 clamp(0.75rem, 2vw, 1.5rem) auto;
    color: inherit;
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    line-height: 1.4;
  }

  .home-hero__cta {
    margin: 0;
    width: 100%;
    padding: 0.55em 6vw;
    line-height: 1;
    align-items: center;
    color: #111;
    background: #fff;
  }

  .home-hero__cta::after {
    display: none;
  }

  @media (max-width: 47.99rem) {
    .home-hero {
      min-height: min(100svh, 54rem);
    }

    .home-hero__content {
      min-height: calc(min(100svh, 54rem) - 2.5rem);
      padding-top: 7rem;
      padding-bottom: 3rem;
    }

    .home-hero__copy {
      max-width: 34rem;
      margin-left: 0;
      text-align: left;
    }

    .home-hero__title {
      max-width: 17ch;
      margin: 0;
      font-size: clamp(2.25rem, 11vw, 3.25rem);
    }

    .home-hero__intro {
      max-width: none;
      margin: 0 0 1rem;
      font-size: 0.95rem;
    }

    .home-hero__media {
      inset: 0 0 2.5rem;
    }

    .home-hero__scrim {
      bottom: 2.5rem;
    }

    .home-hero__cta {
      margin-top: 0;
      padding-inline: 1rem;
    }
  }
</style>
