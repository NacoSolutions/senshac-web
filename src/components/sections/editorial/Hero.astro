---
import { tinaField } from "@tinacms/astro/tina-field";
import MediaPlaceholder from "./MediaPlaceholder.astro";
import RichText from "./RichText.astro";

interface Props {
	title?: string;
	intro?: any;
	ctaText?: string;
	ctaLink?: string;
	mediaId?: string;
	imageAlt?: string;
	mediaType?: "image" | "video";
	placeholderLabel?: string;
	objectFit?: "cover" | "contain";
	eager?: boolean;
	tinaData?: any;
}

const {
	title,
	intro,
	ctaText,
	ctaLink,
	mediaId,
	imageAlt,
	mediaType = "image",
	placeholderLabel,
	objectFit = "cover",
	eager = false,
	tinaData,
} = Astro.props;
---

<section class="editorial-section min-h-auto text-inherit">
  <div class="editorial-shell grid gap-[clamp(2rem,6vw,6rem)]">
    <MediaPlaceholder
      mediaId={mediaId}
      alt={imageAlt}
      kind={mediaType || 'image'}
      label={placeholderLabel}
      aspect="wide"
      objectFit={objectFit}
      eager={eager}
      mediaSlot="full"
      fieldMarker={tinaField(tinaData, 'mediaId')}
    />
    <div class="flex flex-col justify-between">
      <h2 data-tina-field={tinaField(tinaData, 'title')} class="editorial-display">{title}</h2>
      {intro && (
        <div data-tina-field={tinaField(tinaData, 'intro')} class="editorial-lede my-auto" x-reveal>
          <RichText content={intro} />
        </div>
      )}
      {ctaText && ctaLink && <a data-tina-field={tinaField(tinaData, 'ctaLink')} class="editorial-link mt-0" href={ctaLink}><span data-tina-field={tinaField(tinaData, 'ctaText')}>{ctaText}</span></a>}
    </div>
  </div>
</section>
