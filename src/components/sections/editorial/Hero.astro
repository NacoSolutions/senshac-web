---
import { tinaField } from "@tinacms/astro/tina-field";
import MediaPlaceholder from "./MediaPlaceholder.astro";
import RichText from "./RichText.astro";

interface Props {
	title?: string;
	intro?: any;
	ctaText?: string;
	ctaLink?: string;
	mediaId?: string;
	imageAlt?: string;
	mediaType?: "image" | "video";
	placeholderLabel?: string;
	objectFit?: "cover" | "contain";
	eager?: boolean;
	tinaData?: any;
}

const {
	title,
	intro,
	ctaText,
	ctaLink,
	mediaId,
	imageAlt,
	mediaType = "image",
	placeholderLabel,
	objectFit = "cover",
	eager = false,
	tinaData,
} = Astro.props;
---

<section class="home-hero" aria-labelledby={title ? "home-hero-title" : undefined}>
  <div class="home-hero__media">
    <MediaPlaceholder
      mediaId={mediaId}
      alt={imageAlt}
      kind={mediaType || 'image'}
      label={placeholderLabel}
      aspect="wide"
      objectFit={objectFit}
      eager={eager}
      variant="banner"
      mediaSlot="full"
      fieldMarker={tinaField(tinaData, 'mediaId')}
    />
  </div>
  <div class="home-hero__scrim" aria-hidden="true"></div>
  <div class="editorial-shell home-hero__content">
    <div class="home-hero__copy">
      <h2 id={title ? "home-hero-title" : undefined} data-tina-field={tinaField(tinaData, 'title')} class="editorial-display home-hero__title">{title}</h2>
      {intro && (
        <div data-tina-field={tinaField(tinaData, 'intro')} class="editorial-lede home-hero__intro" x-reveal>
          <RichText content={intro} />
        </div>
      )}
      {ctaText && ctaLink && <a data-tina-field={tinaField(tinaData, 'ctaLink')} class="editorial-link home-hero__cta" href={ctaLink}><span data-tina-field={tinaField(tinaData, 'ctaText')}>{ctaText}</span></a>}
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    min-height: min(100svh, 60rem);
    overflow: hidden;
    background: #050505;
    color: #fff;
  }

  .home-hero__media {
    position: absolute;
    inset: 0;
  }


  .home-hero__media :global(picture),
  .home-hero__media :global(video) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .home-hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(0 0 0 / 62%), rgb(0 0 0 / 16%) 72%);
  }

  .home-hero__content {
    position: relative;
    display: flex;
    min-height: min(100svh, 60rem);
    align-items: flex-end;
    padding-top: clamp(7rem, 14vh, 11rem);
    padding-bottom: clamp(3rem, 8vh, 7rem);
  }

  .home-hero__copy {
    max-width: 58rem;
  }

  .home-hero__title {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    line-height: 0.96;
  }

  .home-hero__intro {
    max-width: 34rem;
    margin: clamp(1.25rem, 3vw, 2rem) 0 0;
    color: inherit;
  }

  .home-hero__cta {
    margin-top: clamp(1.5rem, 4vw, 3rem);
    color: inherit;
  }

  @media (max-width: 47.99rem) {
    .home-hero {
      min-height: min(100svh, 54rem);
    }

    .home-hero__content {
      min-height: inherit;
      padding-top: 7rem;
      padding-bottom: 3rem;
    }

    .home-hero__title {
      font-size: clamp(2.25rem, 11vw, 3.5rem);
    }
  }
</style>
