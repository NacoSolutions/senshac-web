---
import { tinaField } from "@tinacms/astro/tina-field";
import RichText from "./RichText.astro";

interface Item {
	title?: string;
	text?: any;
	href?: string;
	ctaText?: string;
}

interface Props {
	title?: string;
	intro?: any;
	items?: Item[] | null;
	tinaData?: any;
}

const { title, intro, items: itemList, tinaData } = Astro.props;
const items = itemList ?? [];
const itemHeadingLevel = title ? "h3" : "h2";
---

<section class="editorial-section">
  <div class="editorial-shell">
    {title && <h2 data-tina-field={tinaField(tinaData, 'title')} class="editorial-heading editorial-heading--compact" x-reveal>{title}</h2>}
    {intro && (
      <div data-tina-field={tinaField(tinaData, 'intro')} class="editorial-body max-w-[52rem] mb-[clamp(2.5rem,5vw,5rem)] whitespace-normal">
        <RichText content={intro} />
      </div>
    )}
    <div class="border-t border-[#111]">
      {items.map((item, index) => (
        <article class="grid gap-4 py-6 border-b border-[#111] md:grid-cols-2 md:gap-8 md:py-10">
          {itemHeadingLevel === "h3" ? (
            <h3 data-tina-field={tinaField(tinaData.items[index], 'title')} class="m-0 text-[clamp(1.15rem,2.3vw,2rem)] font-medium leading-[1.05] uppercase">{item.href ? <a href={item.href} class="underline-offset-4 hover:underline">{item.title} <span aria-hidden="true">↗</span></a> : item.title}</h3>
          ) : (
            <h2 data-tina-field={tinaField(tinaData.items[index], 'title')} class="m-0 text-[clamp(1.15rem,2.3vw,2rem)] font-medium leading-[1.05] uppercase">{item.href ? <a href={item.href} class="underline-offset-4 hover:underline">{item.title} <span aria-hidden="true">↗</span></a> : item.title}</h2>
          )}
          <div>
            <div data-tina-field={tinaField(tinaData.items[index], 'text')} class="[&>p]:m-0 [&>p]:text-base [&>p]:leading-[1.45]"><RichText content={item.text} /></div>
            {item.ctaText && item.href && (
              <a data-tina-field={tinaField(tinaData.items[index], 'ctaText')} href={item.href} class="editorial-link mt-6 inline-flex">{item.ctaText}</a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
