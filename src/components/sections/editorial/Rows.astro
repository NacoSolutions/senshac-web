---
import { tinaField } from "@tinacms/astro/tina-field";
import { getTranslations } from "../../../utils/translations";
import RichText from "./RichText.astro";
import MediaPlaceholder from "./MediaPlaceholder.astro";

interface Item {
	number?: string;
	title?: string;
	text?: any;
	href?: string;
	ctaText?: string;
}

interface Props {
	variant?: "default" | "phase-scroll";
	inquiryStyle?: boolean;
	title?: string;
	intro?: any;
	items?: Item[] | null;
	mediaId?: string | null;
	imageAlt?: string;
	placeholderLabel?: string;
	tinaData?: any;
}

const {
	variant,
	inquiryStyle,
	title,
	intro,
	items: itemList,
	mediaId,
	imageAlt,
	placeholderLabel,
	tinaData,
} = Astro.props;
const items = itemList ?? [];
const itemHeadingLevel = title ? "h3" : "h2";
const lang = Astro.url.pathname.split("/")[1] || "es";
const translations = variant === "phase-scroll" ? await getTranslations(lang) : null;
const previousSlideLabel = translations?.accessibility.previousSlide ?? "";
const nextSlideLabel = translations?.accessibility.nextSlide ?? "";
---

{variant === "phase-scroll" ? (
  <section class="editorial-section editorial-phase-scroll" aria-labelledby="home-phase-title">
    <div class="editorial-shell">
      <div class="editorial-phase-scroll__copy">
        {title && <h2 id="home-phase-title" data-tina-field={tinaField(tinaData, "title")}>{title}</h2>}
        {intro && <div data-tina-field={tinaField(tinaData, "intro")}><RichText content={intro} /></div>}
      </div>
      <div class="editorial-phase-scroll__layout">
        <div class="editorial-phase-scroll__image">
          <MediaPlaceholder
            mediaId={mediaId}
            alt={imageAlt}
            label={placeholderLabel}
            aspect="landscape"
            mediaSlot="content"
            fieldMarker={tinaField(tinaData, "mediaId")}
          />
        </div>
        <div
          class="editorial-phase-scroll__carousel"
          data-phase-scroll
          x-data={`{
            canGoBack: false,
            canGoForward: false,
            updateScrollState() {
              const track = this.$refs.track;
              this.canGoBack = track.scrollLeft > 1;
              this.canGoForward = track.scrollLeft + track.clientWidth < track.scrollWidth - 1;
            },
            move(direction) {
              const track = this.$refs.track;
              const trackBounds = track.getBoundingClientRect();
              const cards = Array.from(track.querySelectorAll("[data-phase-card]"));
              const target = direction > 0
                ? cards.find((card) => card.getBoundingClientRect().right > trackBounds.right + 1)
                : cards.reverse().find((card) => card.getBoundingClientRect().left < trackBounds.left - 1);
              if (!target) return;
              const left = track.scrollLeft + target.getBoundingClientRect().left - trackBounds.left;
              const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
              track.scrollTo({ left, behavior });
            },
          }`}
          x-init="updateScrollState()"
          x-on:resize.window="updateScrollState()"
        >
          <div
            class="editorial-phase-scroll__track"
            data-phase-track
            role="region"
            aria-label={title || nextSlideLabel}
            tabindex="0"
            x-ref="track"
            x-on:scroll.debounce.100ms="updateScrollState()"
          >
            {items.map((item, index) => (
              <article class="editorial-phase-scroll__card" data-phase-card>
                <span data-tina-field={tinaField(tinaData.items[index], "number")} class="editorial-phase-scroll__number">{item.number ?? String(index + 1).padStart(2, "0")}</span>
                <h3 data-tina-field={tinaField(tinaData.items[index], "title")}>{item.title}</h3>
                <div data-tina-field={tinaField(tinaData.items[index], "text")} class="editorial-phase-scroll__text"><RichText content={item.text} /></div>
              </article>
            ))}
          </div>
          <div class="editorial-phase-scroll__controls">
            <button
              type="button"
              aria-label={previousSlideLabel}
              x-bind:disabled="!canGoBack"
              x-on:click="move(-1)"
            ><span class="i-lucide-arrow-left h-4 w-4" aria-hidden="true" /></button>
            <button
              type="button"
              aria-label={nextSlideLabel}
              x-bind:disabled="!canGoForward"
              x-on:click="move(1)"
            ><span class="i-lucide-arrow-right h-4 w-4" aria-hidden="true" /></button>
          </div>
        </div>
      </div>
    </div>
  </section>
) : (
  <section class={`editorial-section${inquiryStyle ? " editorial-inquiry-flows" : ""}`}>
    <div class="editorial-shell">
      {title && <h2 data-tina-field={tinaField(tinaData, 'title')} class="editorial-heading editorial-heading--compact" x-reveal>{title}</h2>}
      {intro && (
        <div data-tina-field={tinaField(tinaData, 'intro')} class="editorial-body max-w-[52rem] mb-[clamp(2.5rem,5vw,5rem)] whitespace-normal">
          <RichText content={intro} />
        </div>
      )}
      <div class="border-t border-[#111]">
        {items.map((item, index) => (
          <article class="grid gap-4 py-6 border-b border-[#111] md:grid-cols-2 md:gap-8 md:py-10">
            {itemHeadingLevel === "h3" ? (
              <h3 data-tina-field={tinaField(tinaData.items[index], 'title')} class="m-0 text-[clamp(1.15rem,2.3vw,2rem)] font-medium leading-[1.05] uppercase">{item.href ? <a href={item.href} class={inquiryStyle && index === 3 ? "underline underline-offset-4" : "underline-offset-4 hover:underline"}>{item.title} <span aria-hidden="true" class={inquiryStyle && index < 3 ? "editorial-inquiry-arrow" : undefined}>↗</span></a> : item.title}</h3>
            ) : (
              <h2 data-tina-field={tinaField(tinaData.items[index], 'title')} class="m-0 text-[clamp(1.15rem,2.3vw,2rem)] font-medium leading-[1.05] uppercase">{item.href ? <a href={item.href} class={inquiryStyle && index === 3 ? "underline underline-offset-4" : "underline-offset-4 hover:underline"}>{item.title} <span aria-hidden="true" class={inquiryStyle && index < 3 ? "editorial-inquiry-arrow" : undefined}>↗</span></a> : item.title}</h2>
            )}
            <div>
              <div data-tina-field={tinaField(tinaData.items[index], 'text')} class="[&>p]:m-0 [&>p]:text-base [&>p]:leading-[1.45]"><RichText content={item.text} /></div>
              {item.ctaText && item.href && (
                <a data-tina-field={tinaField(tinaData.items[index], 'ctaText')} href={item.href} class="editorial-link mt-6 inline-flex">{item.ctaText}</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .editorial-phase-scroll__copy {
    max-width: 52rem;
    margin: 0 0 clamp(2rem, 4vw, 3.25rem) auto;
  }

  .editorial-phase-scroll__copy :global(h2) {
    margin: 0 0 0.75rem;
    font-size: clamp(1.25rem, 1.8vw, 1.75rem);
    font-weight: 400;
    line-height: 1.35;
  }

  .editorial-inquiry-flows .border-t {
    border-top: 0;
  }

  .editorial-inquiry-flows .border-t > article {
    grid-template-columns: minmax(0, 1fr);
  }

  .editorial-inquiry-flows article:nth-child(-n + 3) h2,
  .editorial-inquiry-flows article:nth-child(-n + 3) h3 {
    font-size: clamp(1.5rem, 3.2vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    text-transform: none;
  }

  .editorial-inquiry-flows article:nth-child(-n + 3) a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    text-decoration: none;
  }

  .editorial-inquiry-flows article:nth-child(-n + 3) a:hover {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .editorial-inquiry-flows article:nth-child(-n + 3) a span {
    font-size: 0.65em;
    margin-left: 0.5em;
  }


  .editorial-inquiry-flows .editorial-inquiry-arrow {
    display: inline-block;
    font-style: normal;
    font-weight: 400;
    transform: translateY(-0.2em);
  }

  .editorial-inquiry-flows article:nth-last-child(2) {
    border-bottom: 0;
  }

  .editorial-inquiry-flows article:last-child {
    margin-top: clamp(1rem, 3vw, 2.5rem);
    padding-top: 1.25rem;
    border-bottom: 0;
  }

  .editorial-inquiry-flows article:last-child h2,
  .editorial-inquiry-flows article:last-child h3 {
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    font-weight: 400;
    line-height: 1.2;
    text-transform: none;
  }

  .editorial-inquiry-flows article:last-child a {
    text-underline-offset: 0.15em;
  }

  .editorial-phase-scroll__copy :global(p) {
    margin: 0;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.45;
  }

  .editorial-phase-scroll__layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.85fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    border: 0;
  }

  .editorial-phase-scroll__layout::before,
  .editorial-phase-scroll__layout::after {
    position: absolute;
    z-index: 1;
    inset-inline: 0;
    height: 1px;
    background: #111;
    content: "";
    pointer-events: none;
  }

  .editorial-phase-scroll__layout::before {
    top: 1rem;
  }

  .editorial-phase-scroll__layout::after {
    bottom: 1rem;
  }

  .editorial-phase-scroll__image {
    align-self: stretch;
    padding: 1.25rem 0;
  }

  .editorial-phase-scroll__image :global(> div) {
    height: 100%;
    min-height: 18rem;
  }

  .editorial-phase-scroll__carousel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.25rem 0;
  }

  .editorial-phase-scroll__track {
    display: flex;
    flex: 1;
    gap: clamp(1.5rem, 3vw, 3rem);
    min-height: 0;
    overflow-x: auto;
    width: 100%;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .editorial-phase-scroll__track::-webkit-scrollbar {
    display: none;
  }

  .editorial-phase-scroll__track:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .editorial-phase-scroll__card {
    flex: 0 0 85%;
    min-width: 0;
    padding: 0.25rem 0;
    scroll-snap-align: start;
  }

  .editorial-phase-scroll__number {
    display: block;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 300;
    line-height: 0.9;
  }

  .editorial-phase-scroll__card h3 {
    margin: 0 0 1rem;
    font-size: clamp(1.2rem, 1.6vw, 1.6rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .editorial-phase-scroll__text {
    max-width: 20rem;
    font-size: 1rem;
    line-height: 1.45;
  }

  .editorial-phase-scroll__text :global(p) {
    margin: 0;
  }

  .editorial-phase-scroll__controls {
    display: flex;
    flex: 0 0 auto;
    justify-content: center;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }

  .editorial-phase-scroll__controls button {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    place-items: center;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .editorial-phase-scroll__controls button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .editorial-phase-scroll__controls button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media (min-width: 768px) {
    .editorial-phase-scroll__card {
      flex-basis: calc(50% - 1.5rem);
    }

    .editorial-phase-scroll__layout::before {
      top: 1.25rem;
    }

    .editorial-phase-scroll__layout::after {
      bottom: 1.25rem;
    }
  }

  @media (max-width: 767px) {
    .editorial-phase-scroll__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .editorial-phase-scroll__image {
      padding: 1rem 0;
    }

    .editorial-phase-scroll__image :global(> div) {
      height: auto;
      min-height: 18rem;
    }

    .editorial-phase-scroll__carousel {
      padding-top: 0.5rem;
    }

    .editorial-phase-scroll__track {
      flex: 0 0 auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-phase-scroll__track {
      scroll-behavior: auto;
    }
  }
</style>
