---
import { tinaField } from "@tinacms/astro/tina-field";
import { getCollection } from "astro:content";
import { getTranslations } from "../../../utils/translations";
import R2Picture from "../../R2Picture.astro";
import MediaPlaceholder from "./MediaPlaceholder.astro";

interface Item {
	title?: string;
	link?: string;
	ctaText?: string;
	mediaId?: string;
	imageAlt?: string;
	placeholderLabel?: string;
}

interface Props {
	eyebrow?: string;
	title?: string;
	ctaText?: string;
	ctaLink?: string;
	mediaType?: "image" | "video";
	mediaId?: string;
	imageAlt?: string;
	placeholderLabel?: string;
	limit?: number;
	maxVisible?: number;
	items?: Item[] | null;
	tinaData?: any;
}

const {
	eyebrow,
	title,
	ctaText,
	ctaLink,
	mediaType = "image",
	mediaId,
	imageAlt,
	placeholderLabel,
	limit,
	maxVisible = 1,
	items: itemList,
	tinaData,
} = Astro.props;
const items = itemList ?? [];

// Auto-populate project slides when no manual items or media are provided.
const lang = Astro.url.pathname.split("/")[1] || "es";
let projectSlides: {
	title: string;
	href: string;
	mediaId: string;
	alt: string;
	category: string;
}[] = [];

if (items.length === 0 && !mediaId) {
	const allProjects = await getCollection("projects", ({ id, data }) => {
		return id.startsWith(`${lang}/`) && !data.draft;
	});
	const sorted = allProjects.sort((a, b) => {
		const dateA = a.data.publishDate?.getTime() || 0;
		const dateB = b.data.publishDate?.getTime() || 0;
		return dateB - dateA;
	});
	projectSlides = sorted.slice(0, limit ?? sorted.length).map((project) => {
		const bannerBlock = project.data.blocks?.find(
			(b: any) => b._template === "media" && b.variant === "banner",
		);
		const sourceMediaId =
			typeof bannerBlock?.mediaId === "string" ? bannerBlock.mediaId : "";
		return {
			title: project.data.title,
			href: `/${lang}/works/${project.data.slug}`,
			mediaId: sourceMediaId
				.replace(/^https:\/\/media\.senshac\.com\/images\//, "")
				.replace(/^\/?images\//, "")
				.replace(
					/\/(?:320|412|480|640|768|1024|1200|1280|1920)\.(?:avif|webp)$/,
					"",
				)
				.replace(/\.[^.]+$/, ""),
			alt:
				typeof bannerBlock?.alt === "string"
					? bannerBlock.alt
					: project.data.title,
			category: project.data.tags?.[0]?.split("/")[0]?.trim() ?? "",
		};
	});
}

const showProjectCarousel = projectSlides.length > 0;
const visibleProjectCount = Math.min(maxVisible, projectSlides.length);
const projectCarouselLabel = showProjectCarousel
	? title ||
		(await getTranslations(lang)).nav.links?.find((link) =>
			link.href.endsWith("/works"),
		)?.label ||
		"Projects"
	: undefined;
---

<section class="editorial-section">
  <div class="editorial-shell">
    {eyebrow && <p data-tina-field={tinaField(tinaData, 'eyebrow')} class="editorial-eyebrow">{eyebrow}</p>}
    {title && <h2 data-tina-field={tinaField(tinaData, 'title')} class="editorial-heading editorial-heading--compact" x-reveal>{title}</h2>}

    {showProjectCarousel ? (
      <div
        class="showcase-project-carousel"
        data-project-carousel
        data-visible-items={visibleProjectCount}
        role="region"
        aria-label={projectCarouselLabel}
      >
        <div
          class="showcase-project-carousel__track"
          data-project-carousel-track
          tabindex="0"
        >
          {projectSlides.map((slide, index) => (
            <a
              href={slide.href}
              class="showcase-project-carousel__slide"
              data-project-slide
            >
              <div class="showcase-project-carousel__media">
                {slide.mediaId ? (
                  <R2Picture
                    id={slide.mediaId}
                    alt={slide.alt}
                    class="w-full h-full object-cover"
                    eager={index === 0}
                    mediaSlot="full"
                    sizes={
                      visibleProjectCount === 3
                        ? "(min-width: 1280px) 426px, (min-width: 768px) 33vw, 86vw"
                        : visibleProjectCount === 2
                          ? "(min-width: 1280px) 608px, (min-width: 768px) 50vw, 86vw"
                          : "100vw"
                    }
                  />
                ) : (
                  <div
                    class="showcase-project-carousel__placeholder"
                    data-project-placeholder
                    role="img"
                    aria-label={slide.alt}
                  >
                    {placeholderLabel ?? slide.title}
                  </div>
                )}
              </div>
              <div class="showcase-project-carousel__overlay">
                {slide.category && <p>{slide.category}</p>}
                <h3>{slide.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    ) : items.length > 0 ? (
      <div data-showcase-items class="grid gap-8 grid-cols-[repeat(auto-fit,minmax(min(100%,20rem),1fr))]">
        {items.map((item, index) =>
          item.link ? (
            <a data-tina-field={tinaField(tinaData.items[index], 'link')} href={item.link} class="flex flex-col gap-4 decoration-none text-inherit">
              <MediaPlaceholder
                mediaId={item.mediaId}
                alt={item.imageAlt}
                label={item.placeholderLabel}
                aspect="landscape"
                mediaSlot="grid"
                fieldMarker={tinaField(tinaData.items[index], 'mediaId')}
              />
              {item.title && <span data-tina-field={tinaField(tinaData.items[index], 'title')} class="text-[1.15rem] font-medium uppercase">{item.title}</span>}
              {item.ctaText && <span data-tina-field={tinaField(tinaData.items[index], 'ctaText')} class="editorial-link">{item.ctaText}</span>}
            </a>
          ) : (
            <div class="flex flex-col gap-4 decoration-none text-inherit">
              <MediaPlaceholder
                mediaId={item.mediaId}
                alt={item.imageAlt}
                label={item.placeholderLabel}
                aspect="landscape"
                mediaSlot="grid"
                fieldMarker={tinaField(tinaData.items[index], 'mediaId')}
              />
              {item.title && <span data-tina-field={tinaField(tinaData.items[index], 'title')} class="text-[1.15rem] font-medium uppercase">{item.title}</span>}
            </div>
          ),
        )}
      </div>
    ) : (
      <MediaPlaceholder
        mediaId={mediaId}
        alt={imageAlt}
        kind={mediaType || 'image'}
        label={placeholderLabel}
        aspect="wide"
        mediaSlot="full"
        fieldMarker={tinaField(tinaData, 'mediaId')}
      />
    )}

    {ctaText && ctaLink && <a data-tina-field={tinaField(tinaData, 'ctaLink')} class="editorial-link mt-[clamp(2rem,5vw,4rem)]" href={ctaLink}><span data-tina-field={tinaField(tinaData, 'ctaText')}>{ctaText}</span></a>}
  </div>
</section>


<style>
  .showcase-project-carousel {
    width: 100%;
    overflow: hidden;
  }

  .showcase-project-carousel__track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
  }

  .showcase-project-carousel__track:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .showcase-project-carousel__slide {
    position: relative;
    display: block;
    flex: 0 0 86%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #dedede;
    color: inherit;
    scroll-snap-align: start;
  }

  .showcase-project-carousel__media,
  .showcase-project-carousel__media > .showcase-project-carousel__placeholder,
  .showcase-project-carousel__media :global(picture),
  .showcase-project-carousel__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .showcase-project-carousel__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #dedede;
    color: #555;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .showcase-project-carousel__overlay {
    position: absolute;
    inset: auto 0 0;
    padding: clamp(1rem, 3vw, 2rem);
    background: linear-gradient(0deg, rgb(0 0 0 / 68%), transparent);
    color: #fff;
  }

  .showcase-project-carousel__overlay p {
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .showcase-project-carousel__overlay h3 {
    margin: 0.25rem 0 0;
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .showcase-project-carousel[data-visible-items="1"] .showcase-project-carousel__slide {
      flex-basis: 100%;
    }

    .showcase-project-carousel[data-visible-items="2"] .showcase-project-carousel__slide {
      flex-basis: calc((100% - 1rem) / 2);
    }

    .showcase-project-carousel[data-visible-items="3"] .showcase-project-carousel__slide {
      flex-basis: calc((100% - 2rem) / 3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-project-carousel__track {
      scroll-behavior: auto;
    }
  }
</style>
