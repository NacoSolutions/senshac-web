---
import { tinaField } from "@tinacms/astro/tina-field";
import type { SiteConfigQuery } from "../../tina/__generated__/types";
import { getSiteConfig } from "../utils/site-config";
import { getTranslations, type Translations } from "../utils/translations";
import { resolvePageChromeFieldTarget } from "../utils/page-chrome.mjs";
import BrandMark from "./BrandMark.astro";

type Appearance = "transparent-adaptive" | "transparent-light" | "transparent-dark" | "opaque-light" | "opaque-dark";
type ChromePart = { mode?: "fixed" | "scrolling"; atFinal?: Appearance; scrolling?: Appearance };

interface Props {
	lang: string;
	translations?: Translations;
	siteData?: SiteConfigQuery["siteConfig"];
	chrome?: { footer?: ChromePart };
	pageData?: Record<string, unknown>;
	pageChromePath?: string;
}

const {
	lang,
	translations: propTranslations,
	siteData: propSiteData,
	chrome: propChrome,
	pageData,
	pageChromePath,
} = Astro.props;
const footer = propChrome?.footer;
const mode = footer?.mode ?? "scrolling";
const scrollingAppearance = footer?.scrolling ?? "opaque-dark";
const finalAppearance = footer?.atFinal ?? "opaque-dark";
const pageChromeTarget = resolvePageChromeFieldTarget(pageData, pageChromePath, "footer");
const appearanceClasses: Record<Appearance, string> = {
	"transparent-adaptive": "bg-transparent text-white",
	"transparent-light": "bg-transparent text-white",
	"transparent-dark": "bg-transparent text-gray-900",
	"opaque-light": "bg-white text-gray-900",
	"opaque-dark": "bg-black text-white",
};

const t = propTranslations ?? (await getTranslations(lang));
const site = (propSiteData ?? (await getSiteConfig())) as any;
const footerData = t.footer as any;
const footerLinks = footerData.links || [];
const menuLinks = footerLinks.filter((link: { href: string }) => !link.href.endsWith("/contact"));
const contactLinkIndex = footerLinks.findIndex((link: { href: string }) => link.href.endsWith("/contact"));
const contactLink = footerLinks[contactLinkIndex];
const attributions = footerData.attributions || [];
const socialLinks = (site.socialLinks || []).filter(
	(link: { name?: string }) => link.name?.toLowerCase() !== "houzz",
);
const whatsappNumber = (
	site.contact?.phoneLink ||
	site.contact?.phone ||
	""
).replace(/\D/g, "");
---

<footer
  x-data={`{ scrolled: false, scrollingAppearance: '${scrollingAppearance}', finalAppearance: '${finalAppearance}' }`}
  x-init="window.addEventListener('scroll', () => { scrolled = window.scrollY > 50 })"
  class:list={[mode === "fixed" ? "fixed bottom-0 left-0 right-0 z-40" : "relative"]}
  data-chrome-mode={mode}
  data-chrome-at-final={finalAppearance}
  data-chrome-scrolling={scrollingAppearance}
  data-tina-field={pageChromeTarget ? tinaField(pageChromeTarget.data, pageChromeTarget.field) : undefined}
  x-bind:class={`scrolled ? '${appearanceClasses[finalAppearance]}' : '${appearanceClasses[scrollingAppearance]}'`}
>
  <div class="editorial-shell pt-16 pb-12 font-sans text-sm leading-tight">
    <div class="grid grid-cols-1 items-start gap-x-6 gap-y-8 md:grid-cols-12">
      <div class="md:col-span-2">
        <h2 class="mb-2 font-sans text-sm font-bold uppercase leading-tight" data-tina-field={tinaField(t.nav, 'menu')}>{t.nav.menu}</h2>
        <ul class="m-0 list-none space-y-1 p-0">
          {menuLinks.map((link: { href: string; label: string }) => {
            const index = footerLinks.indexOf(link);
            return (
              <li>
                <a
                  href={link.href}
                  class="text-current hover:opacity-70 transition-opacity"
                  data-tina-field={tinaField(footerLinks[index], "href")}
                >
                  <span data-tina-field={tinaField(footerLinks[index], "label")}>{link.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <div class="md:col-span-2">
        <h2 class="mb-2 font-sans text-sm font-bold uppercase leading-tight" data-tina-field={tinaField(t.nav, 'social')}>{t.nav.social}</h2>
        <ul class="footer-list m-0 list-none p-0">
          {socialLinks.map((link: any, index: number) => {
            const socialKey = link.name?.toLowerCase() ?? "";
            return (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={link.name}
                  class="footer-link text-current hover:opacity-70 transition-opacity"
                >
                  {socialKey.includes("instagram") && (
                    <svg class="footer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                    </svg>
                  )}
                  {socialKey.includes("linkedin") && (
                    <svg class="footer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                      <rect x="2" y="9" width="4" height="12" />
                      <circle cx="4" cy="4" r="2" />
                    </svg>
                  )}
                  {socialKey.includes("pinterest") && (
                    <svg class="footer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10" />
                      <path d="M8 20l4-9" />
                      <path d="M10.7 14c.437 1.263 1.43 2 2.55 2 2.071 0 3.75-1.554 3.75-4a5 5 0 1 0-9.7 1.7" />
                    </svg>
                  )}
                  <span data-tina-field={tinaField(site.socialLinks, index)}>{link.name}</span>
                  <svg class="footer-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17L17 7" />
                    <path d="M7 7h10v10" />
                  </svg>
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <div class="md:col-span-2">
        {contactLink && (
          <h2 class="mb-2 font-sans text-sm font-bold uppercase leading-tight">
            <a
              href={contactLink.href}
              class="text-current hover:opacity-70 transition-opacity"
              data-tina-field={tinaField(footerLinks[contactLinkIndex], "href")}
            >
              <span data-tina-field={tinaField(footerLinks[contactLinkIndex], "label")}>{contactLink.label}</span>
            </a>
          </h2>
        )}
        <div class="footer-list">
          <a href={`mailto:${site.contact.email}`} class="footer-link text-current hover:opacity-70 transition-opacity">
            <svg class="footer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-10 7L2 7" />
            </svg>
            <span data-tina-field={tinaField(site.contact, 'email')}>{site.contact.email}</span>
          </a>
          <a
            href={`tel:${site.contact.phoneLink || site.contact.phone.replace(/\s/g, "")}`}
            class="footer-link whitespace-nowrap text-current hover:opacity-70 transition-opacity"
          >
            <svg class="footer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <span data-tina-field={tinaField(site.contact, 'phone')}>{site.contact.phone}</span>
          </a>
          {whatsappNumber && (
            <a
              href={`https://wa.me/${whatsappNumber}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp Senshac"
              class="footer-link whitespace-nowrap text-current hover:opacity-70 transition-opacity"
            >
              <svg class="footer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" />
                <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" />
              </svg>
              <span>Sens*hac</span>
              <svg class="footer-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17L17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          )}
        </div>
      </div>

      <div class="md:col-span-6 flex items-start justify-end pt-4 md:pt-0">
        <a href={`/${lang}/`} aria-label="Senshac home" class="footer-star-link block leading-none">
          <span x-show="['transparent-adaptive', 'transparent-light', 'opaque-dark'].includes(scrolled ? finalAppearance : scrollingAppearance)">
            <BrandMark kind="symbol" size="footer" />
          </span>
        </a>
      </div>
    </div>
  </div>

  <div class="editorial-shell border-t border-current/20">
    <div class="flex flex-wrap justify-between gap-4 py-4">
      <div class="text-sm text-current opacity-70">
        {attributions.map((credit: { label: string; name: string }, index: number) => (
          <p>
            <span data-tina-field={tinaField(attributions[index], "label")}>{credit.label}</span>{" "}
            <span data-tina-field={tinaField(attributions[index], "name")}>{credit.name}</span>
          </p>
        ))}
      </div>

      <div class="text-sm text-current opacity-70">
        <p>
          <a
            href={`/${lang}/privacy-policy`}
            class="hover:opacity-100 transition-opacity py-1"
            data-tina-field={tinaField(t.footer, 'privacy')}
          >
            {t.footer.privacy}
          </a>
        </p>
        <p>
          <a
            href={`/${lang}/legal-notice`}
            class="hover:opacity-100 transition-opacity py-1"
            data-tina-field={tinaField(t.footer, 'legal')}
          >
            {t.footer.legal}
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .footer-icon {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
    opacity: 0.78;
  }

  .footer-arrow {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
    opacity: 0.78;
  }

  .footer-star-link :global(.brand-mark--footer) {
    display: block;
    width: 100%;
    font-size: clamp(5.5rem, 9vw, 8.5rem);
    line-height: 0.65;
    margin-top: -0.18em;
  }
</style>
