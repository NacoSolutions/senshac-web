---
import { tinaField } from "@tinacms/astro/tina-field";
import type { SiteConfigQuery } from "../../tina/__generated__/types";
import { getSiteConfig } from "../utils/site-config";
import { getTranslations, type Translations } from "../utils/translations";
import { resolvePageChromeFieldTarget } from "../utils/page-chrome.mjs";
import BrandMark from "./BrandMark.astro";

type Appearance = "transparent-adaptive" | "transparent-light" | "transparent-dark" | "opaque-light" | "opaque-dark";
type ChromePart = { mode?: "fixed" | "scrolling"; atFinal?: Appearance; scrolling?: Appearance };

interface Props {
	lang: string;
	translations?: Translations;
	siteData?: SiteConfigQuery["siteConfig"];
	chrome?: { footer?: ChromePart };
	pageData?: Record<string, unknown>;
	pageChromePath?: string;
}

const {
	lang,
	translations: propTranslations,
	siteData: propSiteData,
	chrome: propChrome,
	pageData,
	pageChromePath,
} = Astro.props;
const footer = propChrome?.footer;
const mode = footer?.mode ?? "scrolling";
const scrollingAppearance = footer?.scrolling ?? "opaque-dark";
const finalAppearance = footer?.atFinal ?? "opaque-dark";
const pageChromeTarget = resolvePageChromeFieldTarget(pageData, pageChromePath, "footer");
const appearanceClasses: Record<Appearance, string> = {
	"transparent-adaptive": "bg-transparent text-white",
	"transparent-light": "bg-transparent text-white",
	"transparent-dark": "bg-transparent text-gray-900",
	"opaque-light": "bg-white text-gray-900",
	"opaque-dark": "bg-black text-white",
};

const t = propTranslations ?? (await getTranslations(lang));
const site = (propSiteData ?? (await getSiteConfig())) as any;
const footerData = t.footer as any;
const footerLinks = footerData.links || [];
const menuLinks = footerLinks.filter((link: { href: string }) => !link.href.endsWith("/contact"));
const contactLinkIndex = footerLinks.findIndex((link: { href: string }) => link.href.endsWith("/contact"));
const contactLink = footerLinks[contactLinkIndex];
const attributions = footerData.attributions || [];
const socialLinks = site.socialLinks;
---

<footer
  x-data={`{ scrolled: false, scrollingAppearance: '${scrollingAppearance}', finalAppearance: '${finalAppearance}' }`}
  x-init="window.addEventListener('scroll', () => { scrolled = window.scrollY > 50 })"
  class:list={[mode === "fixed" ? "fixed bottom-0 left-0 right-0 z-40" : "relative"]}
  data-chrome-mode={mode}
  data-chrome-at-final={finalAppearance}
  data-chrome-scrolling={scrollingAppearance}
  data-tina-field={pageChromeTarget ? tinaField(pageChromeTarget.data, pageChromeTarget.field) : undefined}
  x-bind:class={`scrolled ? '${appearanceClasses[finalAppearance]}' : '${appearanceClasses[scrollingAppearance]}'`}
>
  <div class="max-w-7xl mx-auto px-4 md:px-8 pt-16 pb-12">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <h2 class="mb-4 text-xs uppercase tracking-wider" data-tina-field={tinaField(t.nav, 'menu')}>{t.nav.menu}</h2>
        <ul class="m-0 list-none space-y-2 p-0">
          {menuLinks.map((link: { href: string; label: string }) => {
            const index = footerLinks.indexOf(link);
            return (
              <li>
                <a
                  href={link.href}
                  class="text-current hover:opacity-70 transition-opacity"
                  data-tina-field={tinaField(footerLinks[index], "href")}
                >
                  <span data-tina-field={tinaField(footerLinks[index], "label")}>{link.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <div>
        <h2 class="mb-4 text-xs uppercase tracking-wider" data-tina-field={tinaField(t.nav, 'social')}>{t.nav.social}</h2>
        <ul class="m-0 list-none space-y-2 p-0">
          {socialLinks.map((link: any, index: number) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.name}
                class="text-current hover:opacity-70 transition-opacity"
              >
                <span data-tina-field={tinaField(site.socialLinks, index)}>{link.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        {contactLink && (
          <h2 class="mb-4 text-xs uppercase tracking-wider">
            <a
              href={contactLink.href}
              class="text-current hover:opacity-70 transition-opacity"
              data-tina-field={tinaField(footerLinks[contactLinkIndex], "href")}
            >
              <span data-tina-field={tinaField(footerLinks[contactLinkIndex], "label")}>{contactLink.label}</span>
            </a>
          </h2>
        )}
        <a href={`mailto:${site.contact.email}`} class="block text-current hover:opacity-70 transition-opacity">
          <span data-tina-field={tinaField(site.contact, 'email')}>{site.contact.email}</span>
        </a>
        <a
          href={`tel:${site.contact.phoneLink || site.contact.phone.replace(/\s/g, "")}`}
          class="mt-2 block text-current hover:opacity-70 transition-opacity"
        >
          <span data-tina-field={tinaField(site.contact, 'phone')}>{site.contact.phone}</span>
        </a>
      </div>

      <div class="flex items-start lg:justify-end">
        <a href={`/${lang}/`} aria-label="Senshac home">
          <span x-show="['transparent-adaptive', 'transparent-light', 'opaque-dark'].includes(scrolled ? finalAppearance : scrollingAppearance)">
            <BrandMark kind="symbol" size="footer" />
          </span>
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto border-t border-current/20 px-4 md:px-8">
    <div class="flex flex-wrap justify-between gap-4 py-4">
      <div class="text-sm text-current opacity-70">
        {attributions.map((credit: { label: string; name: string }, index: number) => (
          <p>
            <span data-tina-field={tinaField(attributions[index], "label")}>{credit.label}</span>{" "}
            <span data-tina-field={tinaField(attributions[index], "name")}>{credit.name}</span>
          </p>
        ))}
      </div>

      <div class="text-sm text-current opacity-70">
        <p>
          <a
            href={`/${lang}/privacy-policy`}
            class="hover:opacity-100 transition-opacity py-1"
            data-tina-field={tinaField(t.footer, 'privacy')}
          >
            {t.footer.privacy}
          </a>
        </p>
        <p>
          <a
            href={`/${lang}/legal-notice`}
            class="hover:opacity-100 transition-opacity py-1"
            data-tina-field={tinaField(t.footer, 'legal')}
          >
            {t.footer.legal}
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
