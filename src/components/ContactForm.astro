---
import { getEntry } from "astro:content";
import { tinaField } from "@tinacms/astro/tina-field";
import type { TranslationsQuery } from "../../tina/__generated__/types";
import { mergeContactFormTranslations } from "../utils/contact-form-translations";
import { findServicePackage, scenarioContactHref } from "../utils/service-packages.mjs";

interface Props {
	lang: string;
	translations?: TranslationsQuery["translations"];
}

const { lang, translations: propTranslations } = Astro.props;
const localTranslations = await getEntry("translations", lang);
const t = propTranslations ?? localTranslations?.data;
const f: any = mergeContactFormTranslations(
	t?.contactForm as any,
	localTranslations?.data.contactForm,
);
const paths = f.inquiryPaths.paths;
const requestedPath = Astro.url.searchParams.get("path");
const servicesPage = await getEntry("pages", `${lang}/services`);
const selectedPackage = findServicePackage(
	(servicesPage?.data as any)?.blocks,
	lang,
	Astro.url.searchParams.get("package"),
);
const validPath = paths.some((path: any) => path.value === requestedPath);
const selectedPath = paths.some((path: any) => path.value === requestedPath)
	? requestedPath
	: paths[0].value;
const inquiryError = Astro.url.searchParams.get("contact_error");
const feedback = inquiryError ? f[inquiryError] || f.error : null;
const siteKey =
	import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "1x00000000000000000000AA"; // gitleaks:allow
---

{Astro.url.searchParams.get("contact_success") === "1" ? (
  <div class="p-6 border border-green-300 text-green-900" id="contact-form">
    <p class="text-lg font-medium">{f.success}</p>
  </div>
) : (
  <div id="contact-form-container">
    {feedback && <p class="mb-6 border border-red-300 p-4 text-red-900" role="alert">{feedback}</p>}
    <h2 class="mb-4 text-2xl font-semibold">{f.inquiryPaths.heading}</h2>
    {selectedPackage && <p class="mb-6">{selectedPackage.title}</p>}
    {selectedPackage && !validPath ? (
      <section aria-labelledby="scenario-heading" class="space-y-4">
        <h3 id="scenario-heading" class="text-xl font-semibold">{f.inquiryPaths.chooseLabel}</h3>
        <ul class="grid gap-4 md:grid-cols-3">
          {paths.map((path: any) => (
            <li class="border border-gray-300 p-5">
              <a class="font-semibold underline" href={scenarioContactHref(lang, path.value, selectedPackage.id)}>{path.title}</a>
              <p class="mt-2 text-gray-600">{path.description}</p>
            </li>
          ))}
        </ul>
      </section>
    ) : (
    <div class="cf-turnstile" data-sitekey={siteKey} data-size="invisible"></div>
    <form id="contact-form" class="mt-6 space-y-8" action={`/${lang}/api/contact`} method="POST" enctype="multipart/form-data">
      {selectedPackage && <input type="hidden" name="servicePackage" value={selectedPackage.id} />}
      <div>
        <label for="inquiry-path" class="mb-2 block text-sm font-medium">{f.inquiryPaths.chooseLabel}</label>
        <select id="inquiry-path" name="inquiryPath" required class="w-full border-b border-gray-400 bg-transparent px-2 py-3">
          {paths.map((path: any) => <option value={path.value} selected={path.value === selectedPath}>{path.title}</option>)}
        </select>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        <label class="block text-sm" data-tina-field={tinaField(f, 'name')}>{f.name} *<input name="name" required maxlength="200" autocomplete="name" class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3" /></label>
        <label class="block text-sm" data-tina-field={tinaField(f, 'company')}>{f.company}<input name="company" maxlength="200" autocomplete="organization" class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3" /></label>
        <label class="block text-sm" data-tina-field={tinaField(f, 'email')}>{f.email} *<input type="email" name="email" required maxlength="254" autocomplete="email" class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3" /></label>
        <label class="block text-sm" data-tina-field={tinaField(f, 'phone')}>{f.phone}<input type="tel" name="phone" maxlength="80" autocomplete="tel" class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3" /></label>
      </div>

      {paths.map((path: any, pathIndex: number) => (
        <fieldset data-inquiry-path={path.value} hidden={path.value !== selectedPath} disabled={path.value !== selectedPath} class="space-y-6">
          <legend class="mb-2 text-xl font-semibold" data-tina-field={tinaField(paths, pathIndex)}>{path.title}</legend>
          <p class="text-gray-600">{path.description}</p>
          {path.fields.map((field: any, fieldIndex: number) => field.name === "serviceScope" && selectedPackage ? null : (
            <label class="block text-sm font-medium" for={`inquiry-${path.value}-${field.name}`} data-tina-field={tinaField(path.fields, fieldIndex)}>
              {field.label}{field.required ? " *" : ""}
              {field.kind === "select" ? (
                <select id={`inquiry-${path.value}-${field.name}`} name={field.name} required={field.required} class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3">
                  <option value="">—</option>
                  {field.options.map((option: any, optionIndex: number) => <option value={option.value} data-tina-field={tinaField(field.options, optionIndex)}>{option.label}</option>)}
                </select>
              ) : field.kind === "textarea" ? (
                <textarea id={`inquiry-${path.value}-${field.name}`} name={field.name} required={field.required} maxlength="4000" rows="4" class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3"></textarea>
              ) : field.kind === "file" ? (
                <input id={`inquiry-${path.value}-${field.name}`} type="file" name={field.name} multiple accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp" required={field.required} class="mt-2 block w-full border-b border-gray-400 bg-transparent px-2 py-3" />
              ) : (
                <input id={`inquiry-${path.value}-${field.name}`} type="text" name={field.name} required={field.required} maxlength="4000" class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3" />
              )}
            </label>
          ))}
        </fieldset>
      ))}

      <label class="flex items-start gap-3 text-sm text-gray-700">
        <input type="checkbox" name="privacy" value="accepted" required class="mt-1 h-4 w-4" />
        <span data-tina-field={tinaField(f, 'privacy')}>{f.privacy}</span>
      </label>
      <input type="hidden" name="cf-turnstile-response" id="cf-turnstile-response" />
      <button type="submit" class="bg-black px-8 py-4 text-sm tracking-wider text-white hover:bg-gray-800" data-tina-field={tinaField(f, 'submit')}>{f.submit}</button>
    </form>
    )}
  </div>
)}

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
<script is:inline>
  (() => {
    const form = document.getElementById('contact-form');
    if (!form) return;
    const selector = document.getElementById('inquiry-path');
    const updatePath = () => {
      for (const fieldset of form.querySelectorAll('[data-inquiry-path]')) {
        const active = fieldset.dataset.inquiryPath === selector.value;
        fieldset.hidden = !active;
        fieldset.disabled = !active;
      }
    };
    selector.addEventListener('change', updatePath);
    updatePath();

    let widgetId;
    form.addEventListener('submit', (event) => {
      const token = document.getElementById('cf-turnstile-response');
      if (token.value) return;
      const container = document.querySelector('.cf-turnstile');
      if (!window.turnstile || !container) return;
      event.preventDefault();
      if (widgetId === undefined) {
        widgetId = window.turnstile.render(container, {
          sitekey: container.dataset.sitekey,
          size: 'invisible',
          callback: (response) => {
            token.value = response;
            form.requestSubmit();
          },
          'error-callback': () => {
            const url = new URL(window.location.href);
            url.searchParams.set('contact_error', 'turnstileFailed');
            window.location.assign(url);
          },
        });
      }
      window.turnstile.execute(widgetId);
    });
  })();
</script>
