---
import { getEntry } from "astro:content";
import { tinaField } from "@tinacms/astro/tina-field";
import type { TranslationsQuery } from "../../tina/__generated__/types";

interface Props {
	lang: string;
	translations?: TranslationsQuery["translations"];
}

const { lang, translations: propTranslations } = Astro.props;
const localTranslations = await getEntry("translations", lang);
const contact = propTranslations?.contactForm ?? localTranslations?.data.contactForm;
if (!contact?.inquiryPaths?.paths?.length) {
	throw new Error(`Missing inquiry configuration for locale ${lang}.`);
}
const f: any = contact;
const inquiry = f.inquiryPaths;
const paths = inquiry.paths;
const serviceCatalog = new Map<string, any>();
for (const path of paths) {
	for (const [optionIndex, option] of path.serviceOptions.entries()) {
		const existing = serviceCatalog.get(option.value);
		if (existing && existing.label !== option.label) {
			throw new Error(`Localized service ${option.value} has inconsistent labels.`);
		}
		const service = existing ?? {
			value: option.value,
			label: option.label,
			descriptions: {},
		sourcePath: path,
		sourceIndex: optionIndex,
	};
		service.descriptions[path.value] = option.description;
		serviceCatalog.set(option.value, service);
	}
}
const services = [...serviceCatalog.values()];
const requestedSituation = Astro.url.searchParams.get("situation") ?? "";
const requestedService = Astro.url.searchParams.get("service") ?? "";
const selectedPath = paths.find((path: any) => path.value === requestedSituation) ?? null;
const selectedService = services.find((service) => service.value === requestedService) ?? null;
const selectedServiceOption = selectedPath?.serviceOptions.find(
	(option: any) => option.value === requestedService,
) ?? null;
const selectedServiceOptionIndex = selectedPath?.serviceOptions.findIndex(
	(option: any) => option.value === requestedService,
);
const invalidQuery =
	Astro.url.searchParams.has("path") ||
	Astro.url.searchParams.has("package") ||
	Astro.url.searchParams.getAll("situation").length > 1 ||
	Astro.url.searchParams.getAll("service").length > 1 ||
	(requestedSituation && !selectedPath) ||
	(requestedService && !selectedService) ||
	(Boolean(selectedPath && selectedService && !selectedServiceOption));
const validSelection = Boolean(selectedPath && selectedServiceOption);
const questions = requestedService === "other-challenge"
	? inquiry.alternate
	: selectedPath;
const questionFields = validSelection ? questions.fields : [];
const inquiryError = Astro.url.searchParams.get("contact_error");
const feedback = inquiryError
	? f[inquiryError] || f.error
	: invalidQuery
		? f.invalidSelection
		: null;
const siteKey =
	import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "1x00000000000000000000AA"; // gitleaks:allow
---

{Astro.url.searchParams.get("contact_success") === "1" ? (
	<div class="border border-green-300 p-6 text-green-900" id="contact-form">
		<p class="text-lg font-medium" data-tina-field={tinaField(f, "success")}>{f.success}</p>
	</div>
) : (
	<div id="contact-form-container">
		{feedback && <p class="mb-6 border border-red-300 p-4 text-red-900" role="alert" data-tina-field={tinaField(f, invalidQuery ? "invalidSelection" : inquiryError ?? "error")}>{feedback}</p>}
		<h2 class="mb-4 text-2xl font-semibold" data-tina-field={tinaField(inquiry, "heading")}>{inquiry.heading}</h2>
		<form id="inquiry-selection" class="mt-6 space-y-6" action={`/${lang}/contact`} method="GET">
			<label class="block text-sm font-medium" for="business-situation" data-tina-field={tinaField(inquiry, "situationLabel")}>
				{inquiry.situationLabel}
				<select id="business-situation" name="situation" class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3">
					<option value="" data-tina-field={tinaField(inquiry, "selectPlaceholder")}>{inquiry.selectPlaceholder}</option>
					{paths.map((path: any, index: number) => (
						<option value={path.value} selected={path.value === requestedSituation} data-service-ids={JSON.stringify(path.serviceOptions.map((option: any) => option.value))} data-tina-field={tinaField(path, "title")}>{path.title}</option>
					))}
				</select>
			</label>
			<label class="block text-sm font-medium" for="desired-service" data-tina-field={tinaField(inquiry, "serviceLabel")}>
				{inquiry.serviceLabel}
				<select id="desired-service" name="service" class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3">
					<option value="" data-tina-field={tinaField(inquiry, "selectPlaceholder")}>{inquiry.selectPlaceholder}</option>
					{services.map((service) => (
						<option value={service.value} selected={service.value === requestedService} disabled={Boolean(selectedPath && !selectedPath.serviceOptions.some((option: any) => option.value === service.value))} data-descriptions={JSON.stringify(service.descriptions)} data-tina-field={tinaField(service.sourcePath.serviceOptions[service.sourceIndex], "label")}>{service.label}</option>
					))}
				</select>
				<span id="desired-service-description" class="mt-2 block text-gray-600" aria-live="polite" data-tina-field={selectedServiceOption ? tinaField(selectedPath.serviceOptions, selectedServiceOptionIndex) : undefined}>{selectedServiceOption?.description}</span>
			</label>
			<p id="selection-change-feedback" class="text-sm text-red-800" role="status" hidden data-tina-field={tinaField(f, "invalidSelection")}>{f.invalidSelection}</p>
			<button type="submit" class="border border-black px-6 py-3 text-sm hover:bg-black hover:text-white" data-tina-field={tinaField(inquiry, "continue")}>{inquiry.continue}</button>
		</form>

		{validSelection && (
			<>
				<p class="mt-8 text-gray-600" data-tina-field={tinaField(selectedPath, "description")}>{selectedPath.description}</p>
				<form id="contact-form" class="mt-6 space-y-8" action={`/${lang}/api/contact`} method="POST" enctype="multipart/form-data">
					<input type="hidden" name="businessSituation" value={selectedPath.value} />
					<input type="hidden" name="desiredService" value={requestedService} />
					<div class="cf-turnstile" data-sitekey={siteKey} data-size="invisible"></div>
					<div class="grid grid-cols-1 gap-5 md:grid-cols-2">
						<label class="block text-sm" data-tina-field={tinaField(f, "name")}>{f.name} *<input name="name" required maxlength="200" autocomplete="name" class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3" /></label>
						<label class="block text-sm" data-tina-field={tinaField(f, "company")}>{f.company}<input name="company" maxlength="200" autocomplete="organization" class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3" /></label>
						<label class="block text-sm" data-tina-field={tinaField(f, "email")}>{f.email} *<input type="email" name="email" required maxlength="254" autocomplete="email" class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3" /></label>
						<label class="block text-sm" data-tina-field={tinaField(f, "phone")}>{f.phone}<input type="tel" name="phone" maxlength="80" autocomplete="tel" class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3" /></label>
					</div>

					<fieldset class="space-y-6">
						<legend class="mb-2 text-xl font-semibold" data-tina-field={requestedService === "other-challenge" ? tinaField(inquiry.alternate, "title") : tinaField(selectedPath, "title")}>{requestedService === "other-challenge" ? inquiry.alternate.title : selectedPath.title}</legend>
						{questionFields.map((field: any, fieldIndex: number) => (
							<label class="block text-sm font-medium" for={`inquiry-${requestedService}-${field.name}`} data-tina-field={tinaField(questionFields, fieldIndex)}>
								{field.label}{field.required ? " *" : ""}
								{field.kind === "select" ? (
									<select id={`inquiry-${requestedService}-${field.name}`} name={field.name} required={field.required} class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3">
										<option value="">—</option>
										{field.options.map((option: any, optionIndex: number) => <option value={option.value} data-tina-field={tinaField(field.options, optionIndex)}>{option.label}</option>)}
									</select>
								) : field.kind === "textarea" ? (
									<textarea id={`inquiry-${requestedService}-${field.name}`} name={field.name} required={field.required} maxlength="4000" rows="4" class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3"></textarea>
								) : field.kind === "file" ? (
									<input id={`inquiry-${requestedService}-${field.name}`} type="file" name={field.name} multiple accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp" required={field.required} class="mt-2 block w-full border-b border-gray-400 bg-transparent px-2 py-3" />
								) : (
									<input id={`inquiry-${requestedService}-${field.name}`} type="text" name={field.name} required={field.required} maxlength="4000" class="mt-2 w-full border-b border-gray-400 bg-transparent px-2 py-3" />
								)}
							</label>
						))}
					</fieldset>

					<label class="flex items-start gap-3 text-sm text-gray-700">
						<input type="checkbox" name="privacy" value="accepted" required class="mt-1 h-4 w-4" />
						<span data-tina-field={tinaField(f, "privacy")}>{f.privacy}</span>
					</label>
					<input type="hidden" name="cf-turnstile-response" id="cf-turnstile-response" />
					<button type="submit" class="bg-black px-8 py-4 text-sm tracking-wider text-white hover:bg-gray-800" data-tina-field={tinaField(f, "submit")}>{f.submit}</button>
				</form>
			</>
		)}
	</div>
)}

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
<script is:inline>
	(() => {
		const form = document.getElementById('contact-form');
		const selection = document.getElementById('inquiry-selection');
		if (!selection) return;
		const situation = document.getElementById('business-situation');
		const service = document.getElementById('desired-service');
		const renderedSituation = form?.querySelector('[name="businessSituation"]')?.getAttribute('value');
		const renderedService = form?.querySelector('[name="desiredService"]')?.getAttribute('value');
		const description = document.getElementById('desired-service-description');
		const selectionFeedback = document.getElementById('selection-change-feedback');
		const updateServiceOptions = () => {
			const active = Array.from(situation.options).find((option) => option.value === situation.value);
			const allowed = active ? JSON.parse(active.dataset.serviceIds || '[]') : null;
			const selected = service.value;
			for (const option of service.options) {
				if (!option.value) continue;
				option.disabled = Boolean(allowed && !allowed.includes(option.value));
			}
			if (selected && allowed && !allowed.includes(selected)) {
				service.value = '';
				selectionFeedback.hidden = false;
			} else if (service.value) {
				selectionFeedback.hidden = true;
			}
			if (form) {
				form.hidden =
					situation.value !== renderedSituation || service.value !== renderedService;
			}
			const chosen = service.options[service.selectedIndex];
			const descriptions = JSON.parse(chosen?.dataset.descriptions || '{}');
			description.textContent = descriptions[situation.value] || '';
		};
		situation.addEventListener('change', updateServiceOptions);
		service.addEventListener('change', updateServiceOptions);
		updateServiceOptions();

		if (!form) return;
		let widgetId;
		form.addEventListener('submit', (event) => {
			const token = document.getElementById('cf-turnstile-response');
			if (token.value) return;
			const container = document.querySelector('.cf-turnstile');
			if (!window.turnstile || !container) return;
			event.preventDefault();
			if (widgetId === undefined) {
				widgetId = window.turnstile.render(container, {
					sitekey: container.dataset.sitekey,
					size: 'invisible',
					callback: (response) => {
						token.value = response;
						form.requestSubmit();
					},
					'error-callback': () => {
						const url = new URL(window.location.href);
						url.searchParams.set('contact_error', 'turnstileFailed');
						window.location.assign(url);
					},
				});
			}
			window.turnstile.execute(widgetId);
		});
	})();
</script>
