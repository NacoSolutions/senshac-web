---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePreview from '../components/HomePreview.astro';
import { assertHomeContent } from '../content/contract.mjs';
import fixture from '../../content/tina-fixture.json';

const { title, intro } = assertHomeContent(fixture);
---
<BaseLayout title={title} description={intro}>
  <HomePreview title={title} intro={intro} />
</BaseLayout>
