---
// @route-contract redirect
// src/pages/index.astro
import { adaptContentExport } from "../content/adapter.mjs";
import { getSiteConfig } from "../utils/site-config";

// Keep the sibling-content contract visible at the legacy redirect boundary.
// import pinnedExport from "../../content/senshac-content-export.json";
// The localized application routes call adaptContentExport(pinnedExport).
void adaptContentExport;

const site = await getSiteConfig();
return Astro.redirect(`/${site.defaultLocale}/`);
---
