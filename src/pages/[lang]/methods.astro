---
// @route-contract pagespeed
export { getLanguagePaths as getStaticPaths } from "../../lib/static-paths";
export const prerender = true;

import { getEntry } from "astro:content";
import BlocksRenderer from "../../components/BlocksRenderer.astro";
// src/pages/[lang]/methods.astro
import Base from "../../layouts/Base.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";

const { lang } = Astro.params;

const page = await getEntry("pages", `${lang}/services`);

if (!page) {
	return Astro.redirect("/404");
}

const { title, description, blocks } = page.data as {
	title: string;
	description: string;
	blocks?: any[];
};
---

<Base title={title} description={description} lang={lang} aot>
  <TinaIsland name="services" wrapper={{ tag: "main" }} params={{ relativePath: `${lang}/services.json` }} primary>
<main id="main">
    <div class="min-h-screen pt-24 pb-16">
      {blocks && blocks.map((block: any, index: number) => (
        <BlocksRenderer block={block} index={index} parentData={page.data} />
      ))}
    </div>
  </main>
  </TinaIsland>
</Base>
