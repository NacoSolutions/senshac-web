---
// @route-contract pagespeed
export { getLanguagePaths as getStaticPaths } from "../../lib/static-paths";
export const prerender = true;

import { getEntry } from "astro:content";
import BlocksRenderer from "../../components/BlocksRenderer.astro";
// src/pages/[lang]/methods.astro
import Base from "../../layouts/Base.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";

const { lang } = Astro.params;

const page = await getEntry("pages", `${lang}/services`);

if (!page) {
	return Astro.redirect("/404");
}

const { title, description, chrome, blocks } = page.data as {
	title: string;
	description: string;
	chrome?: any;
	blocks?: any[];
};
---

<Base title={title} description={description} lang={lang} pageChrome={chrome} pageSource={{ collection: "services", relativePath: `${lang}/services.json`, chromePath: "chrome" }} aot>
  <TinaIsland name="services" wrapper={{ tag: "main" }} params={{ relativePath: `${lang}/services.json` }} primary>
    <main id="main" class="services-page">
      <div class="services-page__blocks min-h-screen pt-24 pb-16">
        {blocks && blocks.map((block: any, index: number) => (
          <BlocksRenderer block={block} index={index} parentData={page.data} />
        ))}
      </div>
    </main>
  </TinaIsland>
  <style is:global>
    /* Typography parity with WEB SERVICES.idml across all viewports */
    .services-page [data-block-template="text"]:nth-child(1) .editorial-heading--page {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.75rem, 2.8vw, 2.6rem);
      font-weight: 600;
      line-height: 1.15;
      text-transform: none;
      margin-bottom: 0;
    }

    .services-page [data-block-template="list"]:nth-child(2) .editorial-body {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.05rem, 1.35vw, 1.35rem);
      line-height: 1.45;
      max-width: none;
    }

    .services-page [data-block-template="list"]:nth-child(2) article h2,
    .services-page [data-block-template="list"]:nth-child(2) article h3 {
      font-family: var(--site-font-display, "Jozsika", serif);
      font-weight: 300;
      font-size: clamp(1.25rem, 1.75vw, 1.65rem);
      line-height: 1.15;
      text-transform: none;
    }

    .services-page [data-block-template="list"]:nth-child(2) article p {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1rem, 1.25vw, 1.2rem);
      line-height: 1.45;
    }

    /* 4-step process heading & items */
    .services-page [data-block-template="accordion"]:nth-child(4) .editorial-lede {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      max-width: none;
    }

    .services-page [data-block-template="accordion"]:nth-child(4) .editorial-lede h2 {
      margin: 0;
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.75rem, 2.8vw, 2.6rem);
      font-weight: 600;
      line-height: 1.15;
    }

    .services-page [data-block-template="accordion"]:nth-child(4) details > summary > span:nth-child(1),
    .services-page [data-block-template="accordion"]:nth-child(4) details > summary > span:nth-child(2) {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: 1.375rem;
      font-weight: 700;
      line-height: 1.2;
      text-transform: none;
    }

    /* FAQ accordion heading & items */
    .services-page [data-block-template="accordion"]:nth-child(9) .editorial-lede {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.75rem, 2.5vw, 2.25rem);
      font-weight: 600;
      line-height: 1.2;
      max-width: none;
      margin-bottom: 2rem;
    }

    .services-page [data-block-template="accordion"]:nth-child(9) .editorial-lede p {
      margin: 0;
    }

    .services-page [data-block-template="accordion"]:nth-child(9) details > summary {
      grid-template-columns: 1fr 1.5rem;
    }

    .services-page [data-block-template="accordion"]:nth-child(9) details > summary > span:nth-child(1):empty {
      display: none;
    }

    .services-page [data-block-template="accordion"]:nth-child(9) details > summary > span:nth-child(2) {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.05rem, 1.35vw, 1.35rem);
      font-weight: 700;
      line-height: 1.3;
      text-transform: none;
    }

    .services-page [data-block-template="accordion"]:nth-child(9) details > div {
      padding-left: 0;
      max-width: none;
    }

    @media (min-width: 768px) {
      header .editorial-shell,
      .services-page .editorial-shell,
      footer .editorial-shell {
        width: 88vw;
        max-width: none;
      }
    }

    @media (min-width: 1024px) {
      /* Canonical 88vw 12-column grid with gap-6 (1.5rem) */
      .services-page__blocks {
        width: 88vw;
        max-width: none;
        margin-inline: auto;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
      }

      .services-page__blocks > [data-block-template] {
        grid-column: 1 / -1;
      }

      .services-page__blocks > [data-block-template] .editorial-shell {
        width: 100%;
        max-width: none;
      }

      /* 3 Service Tiers: left heading col 1-4, tiers list col 6-12 */
      .services-page__blocks > [data-block-template="text"]:nth-child(1) {
        grid-column: 1 / 5;
        grid-row: 1;
        align-self: start;
      }

      .services-page__blocks > [data-block-template="list"]:nth-child(2) {
        grid-column: 6 / 13;
        grid-row: 1;
        align-self: start;
      }

      .services-page__blocks > [data-block-template="list"]:nth-child(2) article {
        grid-template-columns: minmax(0, 2fr) minmax(0, 5fr);
        column-gap: 1.5rem;
        align-items: start;
      }

      /* 4-Step Process: heading col 1-4, steps 01-04 col 6-12 */
      .services-page__blocks > [data-block-template="accordion"]:nth-child(4) .editorial-shell {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
        align-items: start;
      }

      .services-page__blocks > [data-block-template="accordion"]:nth-child(4) .editorial-lede {
        grid-column: 1 / 5;
        margin-bottom: 0;
      }

      .services-page__blocks > [data-block-template="accordion"]:nth-child(4) .editorial-shell > .border-t {
        grid-column: 6 / 13;
      }

      /* Callouts aligned to main content rail col 6-12 */
      .services-page__blocks > [data-block-template="callout"] section {
        text-align: left;
      }

      .services-page__blocks > [data-block-template="callout"] .editorial-shell {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
      }

      .services-page__blocks > [data-block-template="callout"] .editorial-shell > a {
        grid-column: 6 / 13;
        justify-self: start;
      }

      /* Bottom 2-image split: col 1-4 + col 6-12 */
      .services-page__blocks > [data-block-template="showcase"] [data-showcase-items] {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
        row-gap: 1.5rem;
        align-items: stretch;
      }

      .services-page__blocks > [data-block-template="showcase"] [data-showcase-items] > :first-child {
        grid-column: 1 / 5;
      }

      .services-page__blocks > [data-block-template="showcase"] [data-showcase-items] > :nth-child(2) {
        grid-column: 6 / 13;
      }

      .services-page__blocks > [data-block-template="showcase"] [data-showcase-items] figure,
      .services-page__blocks > [data-block-template="showcase"] [data-showcase-items] picture,
      .services-page__blocks > [data-block-template="showcase"] [data-showcase-items] img {
        height: 100%;
        object-fit: cover;
      }

      /* FAQ Accordion: col 6-12 */
      .services-page__blocks > [data-block-template="accordion"]:nth-child(9) .editorial-shell {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
      }

      .services-page__blocks > [data-block-template="accordion"]:nth-child(9) .editorial-shell > * {
        grid-column: 6 / 13;
      }
    }
  </style>
</Base>
