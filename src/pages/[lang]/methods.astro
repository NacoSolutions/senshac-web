---
// @route-contract pagespeed
export { getLanguagePaths as getStaticPaths } from "../../lib/static-paths";
export const prerender = true;

import { getEntry } from "astro:content";
import BlocksRenderer from "../../components/BlocksRenderer.astro";
// src/pages/[lang]/methods.astro
import Base from "../../layouts/Base.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";

const { lang } = Astro.params;

const page = await getEntry("pages", `${lang}/services`);

if (!page) {
	return Astro.redirect("/404");
}

const { title, description, chrome, blocks } = page.data as {
	title: string;
	description: string;
	chrome?: any;
	blocks?: any[];
};
---

<Base title={title} description={description} lang={lang} pageChrome={chrome} pageSource={{ collection: "services", relativePath: `${lang}/services.json`, chromePath: "chrome" }} aot>
  <TinaIsland name="services" wrapper={{ tag: "main" }} params={{ relativePath: `${lang}/services.json` }} primary>
    <main id="main" class="services-page">
      <div class="services-page__blocks min-h-screen pt-24 pb-16">
        {blocks && blocks.map((block: any, index: number) => (
          <BlocksRenderer block={block} index={index} parentData={page.data} />
        ))}
      </div>
    </main>
  </TinaIsland>
  <style is:global>
    /* Typography and layout parity with WEB SERVICES.indd (page 2) across all viewports */

    /* Child 1 & Child 4: Wide editorial banners (hero & mid material board) */
    .services-page [data-block-template="showcase"]:nth-child(1) .editorial-section,
    .services-page [data-block-template="showcase"]:nth-child(4) .editorial-section {
      padding-block: 0;
    }

    .services-page [data-block-template="showcase"]:nth-child(1) {
      margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
    }

    .services-page [data-block-template="showcase"]:nth-child(4) {
      margin-block: clamp(3rem, 6vw, 5.5rem);
    }

    .services-page [data-block-template="showcase"]:nth-child(1) .editorial-shell > div,
    .services-page [data-block-template="showcase"]:nth-child(4) .editorial-shell > div {
      aspect-ratio: 16 / 5;
      max-height: 420px;
      width: 100%;
    }

    .services-page [data-block-template="showcase"]:nth-child(1) .editorial-shell > div picture,
    .services-page [data-block-template="showcase"]:nth-child(1) .editorial-shell > div img,
    .services-page [data-block-template="showcase"]:nth-child(4) .editorial-shell > div picture,
    .services-page [data-block-template="showcase"]:nth-child(4) .editorial-shell > div img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Child 2: Page heading ("Servicios a medida de tus necesidades:") */
    .services-page [data-block-template="text"]:nth-child(2) .editorial-heading--page {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.75rem, 2.8vw, 2.6rem);
      font-weight: 600;
      line-height: 1.15;
      text-transform: none;
      margin-bottom: 0;
    }

    /* Child 3: 3 Service Tiers as rounded-border editorial cards */
    .services-page [data-block-template="list"]:nth-child(3) .editorial-body {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.05rem, 1.35vw, 1.3rem);
      line-height: 1.45;
      max-width: none;
      margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
    }

    .services-page [data-block-template="list"]:nth-child(3) .editorial-shell > .border-t {
      border-top: 0;
      display: grid;
      gap: 1.25rem;
    }

    .services-page [data-block-template="list"]:nth-child(3) article {
      border: 1px solid #d4d4d4;
      border-radius: 0.75rem;
      padding: 1.5rem;
      gap: 1rem;
    }

    @media (min-width: 768px) {
      .services-page [data-block-template="list"]:nth-child(3) article {
        padding: 2rem;
        grid-template-columns: minmax(0, 2fr) minmax(0, 5fr);
        column-gap: 1.5rem;
        align-items: start;
      }
    }

    .services-page [data-block-template="list"]:nth-child(3) article h2,
    .services-page [data-block-template="list"]:nth-child(3) article h3 {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-weight: 400;
      font-size: clamp(0.95rem, 1.15vw, 1.1rem);
      letter-spacing: 0.04em;
      line-height: 1.35;
      text-transform: uppercase;
      color: #525252;
    }

    .services-page [data-block-template="list"]:nth-child(3) article h2 a span,
    .services-page [data-block-template="list"]:nth-child(3) article h3 a span {
      display: none;
    }

    .services-page [data-block-template="list"]:nth-child(3) article p {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(0.95rem, 1.15vw, 1.1rem);
      line-height: 1.45;
    }

    .services-page [data-block-template="list"]:nth-child(3) article p:first-child {
      font-weight: 700;
    }

    .services-page [data-block-template="list"]:nth-child(3) article p + p {
      margin-top: 0.75rem;
      font-weight: 400;
    }

    .services-page [data-block-template="list"]:nth-child(3) article .editorial-link {
      margin-top: 1.25rem;
      font-size: 0.9rem;
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    /* Child 5: 4-step process heading & items */
    .services-page [data-block-template="accordion"]:nth-child(5) .editorial-lede {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      max-width: none;
    }

    .services-page [data-block-template="accordion"]:nth-child(5) .editorial-lede h2 {
      margin: 0;
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.75rem, 2.8vw, 2.6rem);
      font-weight: 600;
      line-height: 1.15;
    }

    .services-page [data-block-template="accordion"]:nth-child(5) details > summary > span:nth-child(1),
    .services-page [data-block-template="accordion"]:nth-child(5) details > summary > span:nth-child(2) {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: 1.25rem;
      font-weight: 700;
      line-height: 1.25;
      text-transform: uppercase;
    }

    /* Child 6: Callout ("Empieza tu proyecto ↗") */
    .services-page [data-block-template="callout"]:nth-child(6) section {
      border-block: 0;
      padding-top: 1rem;
      padding-bottom: 2.5rem;
      text-align: left;
    }

    .services-page [data-block-template="callout"]:nth-child(6) a {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.05rem, 1.35vw, 1.25rem);
      border-bottom-width: 1px;
    }

    /* Child 8: FAQ accordion heading & items */
    .services-page [data-block-template="accordion"]:nth-child(8) .editorial-lede {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.5rem, 2.2vw, 2rem);
      font-weight: 600;
      line-height: 1.2;
      max-width: none;
      margin-bottom: 2rem;
    }

    .services-page [data-block-template="accordion"]:nth-child(8) .editorial-lede p {
      margin: 0;
    }

    .services-page [data-block-template="accordion"]:nth-child(8) details > summary {
      grid-template-columns: 1fr 1.5rem;
    }

    .services-page [data-block-template="accordion"]:nth-child(8) details > summary > span:nth-child(1):empty {
      display: none;
    }

    .services-page [data-block-template="accordion"]:nth-child(8) details > summary > span:nth-child(2) {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.05rem, 1.35vw, 1.25rem);
      font-weight: 700;
      line-height: 1.3;
      text-transform: none;
    }

    .services-page [data-block-template="accordion"]:nth-child(8) details > div {
      padding-left: 0;
      max-width: none;
    }

    @media (min-width: 768px) {
      header .editorial-shell,
      .services-page .editorial-shell,
      footer .editorial-shell {
        width: 88vw;
        max-width: none;
      }
    }

    @media (min-width: 1024px) {
      /* Canonical 88vw 12-column grid with gap-6 (1.5rem) */
      .services-page__blocks {
        width: 88vw;
        max-width: none;
        margin-inline: auto;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
      }

      .services-page__blocks > [data-block-template] {
        grid-column: 1 / -1;
      }

      .services-page__blocks > [data-block-template] .editorial-shell {
        width: 100%;
        max-width: none;
      }

      /* Child 1: Top hero banner full 88vw */
      .services-page__blocks > [data-block-template="showcase"]:nth-child(1) {
        grid-column: 1 / -1;
        grid-row: 1;
      }

      /* Child 2 & 3: 3 Service Tiers: left heading col 1-4, tiers list col 6-12 */
      .services-page__blocks > [data-block-template="text"]:nth-child(2) {
        grid-column: 1 / 5;
        grid-row: 2;
        align-self: start;
      }

      .services-page__blocks > [data-block-template="list"]:nth-child(3) {
        grid-column: 6 / 13;
        grid-row: 2;
        align-self: start;
      }

      /* Child 5: 4-Step Process: heading col 1-4, steps 01-04 col 6-12 */
      .services-page__blocks > [data-block-template="accordion"]:nth-child(5) .editorial-shell {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
        align-items: start;
      }

      .services-page__blocks > [data-block-template="accordion"]:nth-child(5) .editorial-lede {
        grid-column: 1 / 5;
        margin-bottom: 0;
      }

      .services-page__blocks > [data-block-template="accordion"]:nth-child(5) .editorial-shell > .border-t {
        grid-column: 6 / 13;
      }

      /* Child 6: Callout aligned to main content rail col 6-12 */
      .services-page__blocks > [data-block-template="callout"]:nth-child(6) .editorial-shell {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
      }

      .services-page__blocks > [data-block-template="callout"]:nth-child(6) .editorial-shell > a {
        grid-column: 6 / 13;
        justify-self: start;
      }

      /* Child 7: Bottom 2-image split: col 1-4 + col 6-12 */
      .services-page__blocks > [data-block-template="showcase"]:nth-child(7) [data-showcase-items] {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
        row-gap: 1.5rem;
        align-items: stretch;
      }

      .services-page__blocks > [data-block-template="showcase"]:nth-child(7) [data-showcase-items] > :first-child {
        grid-column: 1 / 5;
      }

      .services-page__blocks > [data-block-template="showcase"]:nth-child(7) [data-showcase-items] > :nth-child(2) {
        grid-column: 6 / 13;
      }

      .services-page__blocks > [data-block-template="showcase"]:nth-child(7) [data-showcase-items] figure,
      .services-page__blocks > [data-block-template="showcase"]:nth-child(7) [data-showcase-items] picture,
      .services-page__blocks > [data-block-template="showcase"]:nth-child(7) [data-showcase-items] img {
        height: 100%;
        object-fit: cover;
      }

      /* Child 8: FAQ Accordion: col 6-12 */
      .services-page__blocks > [data-block-template="accordion"]:nth-child(8) .editorial-shell {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
      }

      .services-page__blocks > [data-block-template="accordion"]:nth-child(8) .editorial-shell > * {
        grid-column: 6 / 13;
      }
    }
  </style>
</Base>
