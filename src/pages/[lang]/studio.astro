---
// @route-contract pagespeed
export { getLanguagePaths as getStaticPaths } from "../../lib/static-paths";
export const prerender = true;

import { getEntry } from "astro:content";
import BlocksRenderer from "../../components/BlocksRenderer.astro";
// src/pages/[lang]/studio.astro
import Base from "../../layouts/Base.astro";

const { lang } = Astro.params;

const page = await getEntry("pages", `${lang}/about`);

if (!page) {
	return Astro.redirect("/404");
}

const { title, description, blocks } = page.data as {
	title: string;
	description: string;
	blocks?: any[];
};
---

<Base title={title} description={description} lang={lang} schema="LocalBusiness" aot>
  <main id="main">
    <div class="min-h-screen pt-24 pb-16">
      {blocks && blocks.map((block: any, index: number) => (
        <BlocksRenderer block={block} index={index} parentData={page.data} />
      ))}
    </div>
  </main>
</Base>
