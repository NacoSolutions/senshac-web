---
// @route-contract pagespeed
export { getLanguagePaths as getStaticPaths } from "../../lib/static-paths";
export const prerender = true;

import { getEntry } from "astro:content";
import BlocksRenderer from "../../components/BlocksRenderer.astro";
// src/pages/[lang]/studio.astro
import Base from "../../layouts/Base.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";

const { lang } = Astro.params;

const page = await getEntry("pages", `${lang}/about`);

if (!page) {
	return Astro.redirect("/404");
}

const { title, description, chrome, blocks } = page.data as {
	title: string;
	description: string;
	chrome?: any;
	blocks?: any[];
};
---

<Base title={title} description={description} lang={lang} schema="LocalBusiness" pageChrome={chrome} pageSource={{ collection: "about", relativePath: `${lang}/about.json`, chromePath: "chrome" }} aot>
  <TinaIsland name="about" wrapper={{ tag: "main" }} params={{ relativePath: `${lang}/about.json` }} primary>
    <main id="main" class="studio-page">
      <div class="min-h-screen pt-24 pb-16">
        {blocks && blocks.map((block: any, index: number) => (
          <BlocksRenderer block={block} index={index} parentData={page.data} />
        ))}
      </div>
    </main>
  </TinaIsland>
  <style is:global>
    .studio-page .studio-intro__title {
      max-width: none;
      margin: 0;
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(2.25rem, 3.6vw, 3.25rem);
      font-weight: 600;
      line-height: 1.1;
      text-transform: none;
    }

    .studio-page [data-block-template="statement"] .editorial-body {
      columns: 1;
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.05rem, 1.35vw, 1.35rem);
      line-height: 1.5;
    }

    .studio-page [data-block-template="statement"] .editorial-body p,
    .studio-page [data-block-template="text"] .editorial-body p {
      margin: 0 0 1.25em;
    }

    .studio-page [data-block-template="statement"] .editorial-body p:last-child,
    .studio-page [data-block-template="text"] .editorial-body p:last-child {
      margin-bottom: 0;
    }

    .studio-page .editorial-body strong,
    .studio-page .editorial-body b {
      font-weight: 600;
    }

    .studio-page .editorial-body em,
    .studio-page .editorial-body i {
      font-style: italic;
    }

    .studio-page [data-block-template="statement"] .editorial-body h2 {
      margin: clamp(2rem, 4vw, 3.5rem) 0 1rem;
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.75rem, 2.8vw, 2.6rem);
      font-weight: 600;
      line-height: 1.15;
      text-transform: none;
    }

    .studio-page [data-block-template="statement"] .editorial-display {
      max-width: none;
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(2.25rem, 4.5vw, 4.25rem);
      font-weight: 600;
      line-height: 1.05;
      text-transform: none;
    }

    .studio-page [data-block-template="showcase"] .editorial-section {
      padding-block: clamp(2.5rem, 5vw, 4.5rem);
    }

    .studio-page [data-block-template="text"] .editorial-heading,
    .studio-page [data-block-template="list"] .editorial-heading {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.75rem, 2.8vw, 2.6rem);
      font-weight: 600;
      line-height: 1.15;
      text-transform: none;
    }

    .studio-page [data-block-template="text"] .editorial-body {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.05rem, 1.35vw, 1.35rem);
      line-height: 1.5;
    }

    .studio-page [data-block-template="list"] article {
      align-items: baseline;
      gap: 0.75rem 1.5rem;
      padding-block: 1.25rem;
    }

    .studio-page [data-block-template="list"] article h2,
    .studio-page [data-block-template="list"] article h3 {
      font-family: var(--site-font-display, "Jozsika", serif);
      font-size: clamp(1rem, 1.25vw, 1.2rem);
      font-weight: 300;
      line-height: 1.3;
      letter-spacing: 0.04em;
    }

    .studio-page [data-block-template="list"] article p {
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(0.95rem, 1.1vw, 1.1rem);
      line-height: 1.45;
    }

    .studio-page [data-block-template="callout"] section {
      text-align: left;
    }

    .studio-page [data-block-template="callout"] a {
      font-family: var(--site-font-display, "Jozsika", serif);
      font-size: clamp(1.25rem, 1.8vw, 1.75rem);
      font-weight: 300;
      letter-spacing: 0.02em;
    }

    @media (min-width: 768px) {
      .studio-page .editorial-shell,
      body:has(.studio-page) header .editorial-shell,
      body:has(.studio-page) footer .editorial-shell {
        width: 88vw;
        max-width: none;
        margin-inline: auto;
      }
    }

    @media (min-width: 1024px) {
      .studio-page [data-block-template="statement"] > section:first-of-type .editorial-shell {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
        row-gap: 2.5rem;
        align-items: start;
      }

      .studio-page [data-block-template="statement"] > section:first-of-type .editorial-shell > div:first-child {
        grid-column: 1 / 5;
        max-width: none;
        margin: 0;
      }

      .studio-page [data-block-template="statement"] > section:first-of-type .editorial-shell > div:nth-child(2) {
        grid-column: 6 / 13;
        max-width: none;
        gap: 1.75rem;
      }

      .studio-page [data-block-template="statement"] > section:nth-of-type(2) .editorial-shell {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
      }

      .studio-page [data-block-template="statement"] > section:nth-of-type(2) .editorial-display {
        grid-column: 1 / -1;
      }

      .studio-page [data-block-template="text"] .editorial-shell,
      .studio-page [data-block-template="list"] .editorial-shell {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
        row-gap: 1.5rem;
        align-items: start;
      }

      .studio-page [data-block-template="text"] .editorial-heading,
      .studio-page [data-block-template="list"] .editorial-heading {
        grid-column: 1 / 5;
        margin-bottom: 0;
      }

      .studio-page [data-block-template="text"] .editorial-body,
      .studio-page [data-block-template="list"] .editorial-shell > .border-t {
        grid-column: 6 / 13;
        max-width: none;
      }

      .studio-page [data-block-template="callout"] .editorial-shell {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
      }

      .studio-page [data-block-template="callout"] a {
        grid-column: 6 / 13;
        justify-self: start;
      }
    }
  </style>
</Base>
