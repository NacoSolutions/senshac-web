---
export const prerender = false;

import { getEntry } from "astro:content";
import BlocksRenderer from "../../components/BlocksRenderer.astro";
// src/pages/[lang]/contact.astro
import Base from "../../layouts/Base.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";

const { lang } = Astro.params;

const page = await getEntry("pages", `${lang}/contact`);

if (!page) {
	return Astro.redirect("/404");
}

const { title, description, chrome, blocks } = page.data as {
	title: string;
	description: string;
	chrome?: any;
	blocks?: any[];
};

const pageChrome = {
	...chrome,
	header: {
		...chrome?.header,
		style: "transparent" as const,
		mode: "fixed" as const,
		scrolling: "transparent-light" as const,
		atFinal: "opaque-light" as const,
	},
};
---

<Base title={title} description={description} lang={lang ?? "es"} schema="LocalBusiness" headerStyle="transparent" pageChrome={pageChrome} pageSource={{ collection: "contact", relativePath: `${lang}/contact.json`, chromePath: "chrome" }} aot>
  <TinaIsland name="contact" wrapper={{ tag: "main" }} params={{ relativePath: `${lang}/contact.json` }} primary>
    <main id="main" class="contact-page min-h-screen">
      {blocks && blocks.map((block: any, index: number) => (
        <BlocksRenderer block={block} index={index} parentData={page.data} />
      ))}
    </main>
  </TinaIsland>
  <style is:global>
    @media (min-width: 768px) {
      .contact-page .editorial-shell,
      body:has(.contact-page) header .editorial-shell,
      body:has(.contact-page) footer .editorial-shell {
        width: 88vw;
        max-width: none;
        margin-inline: auto;
      }
    }
  </style>
</Base>
