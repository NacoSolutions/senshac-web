---
// @route-contract pagespeed
export { getLanguagePaths as getStaticPaths } from "../../../lib/static-paths";
export const prerender = true;

import { getCollection, getEntry } from "astro:content";
import MediaPlaceholder from "../../../components/sections/editorial/MediaPlaceholder.astro";
import { tinaField } from "@tinacms/astro/tina-field";
import Base from "../../../layouts/Base.astro";

const { lang = "es" } = Astro.params;
const translations = await getEntry("translations", lang);
const t = translations?.data.projects;

if (!t) {
	return Astro.redirect("/404");
}

const allProjects = await getCollection("projects", ({ id, data }) => {
	return id.startsWith(`${lang}/`) && !data.draft;
});

// Sort by publishDate descending
const sortedProjects = allProjects.sort((a, b) => {
	const dateA = a.data.publishDate?.getTime() || 0;
	const dateB = b.data.publishDate?.getTime() || 0;
	return dateB - dateA;
});

const layouts = [
	"wide-right",
	"portrait-left",
	"wide-center",
	"landscape-left",
	"landscape-right",
];

const works = sortedProjects.map((project, index) => {
	const bannerBlock = project.data.blocks?.find(
		(b: any) => b._template === "media" && b.variant === "banner",
	);

	return {
		category: project.data.tags?.[0] || "Proyecto",
		title: project.data.title,
		summary: project.data.description,
		href: `/${lang}/works/${project.data.slug}`,
		mediaId:
			typeof bannerBlock?.mediaId === "string"
				? bannerBlock.mediaId
				: undefined,
		alt: bannerBlock?.alt || project.data.title,
		placeholderLabel: `${project.data.title}: imagen pendiente`,
		layout: layouts[index % layouts.length],
	};
});
const breadcrumbs = [{ name: "Works", url: `/${lang}/works` }];
---

<Base title={t.title} description={t.description} lang={lang} pageChrome={t.chrome} pageSource={{ collection: "translations", relativePath: `${lang}.json`, chromePath: "projects.chrome" }} schema="BreadcrumbList" breadcrumbs={breadcrumbs}>
  <main id="main" class="works-index">
    <div class="editorial-shell">
      <h1 class="works-index__title" data-tina-field={tinaField(t, "heading")}>
        {t.heading.split("\n").map((line: string, index: number) => (
          <>{index > 0 && <br />}{index === 1 ? <em>{line}</em> : line}</>
        ))}
      </h1>

      <div class="works-index__list">
        {works.map((work) => {
          const content = (
            <MediaPlaceholder
              mediaId={work.mediaId}
              alt={`${work.category}: ${work.title}`}
              label={work.placeholderLabel}
              aspect={work.layout === "portrait-left" ? "portrait" : "landscape"}
              mediaSlot="content"
            />
          );
          return (
            <article class="works-index__item">
              <p class="works-index__label">{work.category} / {work.title}</p>
              {work.href ? (
                <a href={work.href} class="works-index__media">
                  {content}
                </a>
              ) : (
                <div class="works-index__media" aria-label={`${work.category}: ${work.title}`}>
                  {content}
                </div>
              )}
              <p class="works-index__summary">{work.summary}</p>
            </article>
          );
        })}
      </div>
    </div>

  </main>
</Base>

<style>
.works-index {
  padding-top: clamp(7rem, 12vw, 11rem);
}

.works-index__title {
  margin: 0;
  font-family: 'Sinteca', system-ui, sans-serif;
  font-size: clamp(2.5rem, 5vw, 4.5rem);
  font-weight: 500;
  line-height: 0.78;
  text-transform: uppercase;
}

.works-index__title em {
  font-weight: 500;
}

.works-index__list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(3rem, 6vw, 6rem) 1.5rem;
  padding-top: clamp(5rem, 10vw, 9rem);
}

.works-index__item {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.works-index__media {
  display: block;
  width: 100%;
}

.works-index__media .editorial-media {
  height: 100%;
}

.works-index__label,
.works-index__summary {
  margin: 0;
  font-size: clamp(0.85rem, 1.2vw, 1rem);
  line-height: 1.35;
}

.works-index__label {
  margin-bottom: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
}

.works-index__summary {
  margin-top: 0.75rem;
}

@media (max-width: 47.99rem) {
  .works-index {
    padding-top: 7rem;
  }

  .works-index__title {
    font-size: clamp(2.4rem, 13vw, 3.4rem);
  }

  .works-index__list {
    grid-template-columns: 1fr;
    gap: 4rem;
    padding-top: 5rem;
  }
}
</style>
