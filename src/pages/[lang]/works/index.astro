---
// @route-contract pagespeed
export { getLanguagePaths as getStaticPaths } from "../../../lib/static-paths";
export const prerender = true;

import { getEntry } from "astro:content";
import { tinaField } from "@tinacms/astro/tina-field";
import R2Picture from "../../../components/R2Picture.astro";
import Base from "../../../layouts/Base.astro";

type Locale = "es" | "ca" | "en";
type CardSpan = "full" | "left-5" | "right-7" | "left-7" | "right-5";

interface EditorialCard {
	id: string;
	mediaId: string;
	span: CardSpan;
	category: string;
	title: string;
	description?: string;
	href?: string;
	badge?: {
		primary: string;
		secondary?: string;
	};
	lightSurface?: boolean;
	eager?: boolean;
}

const rawLang = Astro.params.lang ?? "es";
const lang: Locale =
	rawLang === "ca" || rawLang === "en" ? rawLang : "es";

const translations = await getEntry("translations", lang);
const t = translations?.data.projects;

if (!t) {
	return Astro.redirect("/404");
}

const HEADINGS: Record<Locale, { before: string; italic: string; secondLine: string }> = {
	es: { before: "PROYECTOS, ", italic: "ENSAYOS", secondLine: "Y OBJETOS" },
	ca: { before: "PROJECTES, ", italic: "ASSAIGS", secondLine: "I OBJECTES" },
	en: { before: "PROJECTS, ", italic: "ESSAYS", secondLine: "AND OBJECTS" },
};

const IN_PROGRESS: Record<Locale, string> = {
