const SIZES_BY_SPAN: Record<CardSpan, string> = {
	full: "(min-width: 768px) 88vw, 100vw",
	"left-7": "(min-width: 768px) 52vw, 100vw",
	"right-7": "(min-width: 768px) 52vw, 100vw",
	"left-5": "(min-width: 768px) 37vw, 100vw",
	"right-5": "(min-width: 768px) 37vw, 100vw",
};

const heading = HEADINGS[lang];
const cards = CARDS_BY_LOCALE[lang];
const breadcrumbs = [{ name: "Works", url: `/${lang}/works` }];
---

<Base title={t.title} description={t.description} lang={lang} pageChrome={t.chrome} pageSource={{ collection: "translations", relativePath: `${lang}.json`, chromePath: "projects.chrome" }} schema="BreadcrumbList" breadcrumbs={breadcrumbs}>
  <main id="main" class="works-index">
    <div class="editorial-shell">
      <h1 class="works-index__title" data-tina-field={tinaField(t, "heading")}>
        {heading.before}<em>{heading.italic}</em><br />{heading.secondLine}
      </h1>

      <div class="works-index__list">
        {cards.map((card) => {
          const cardLabel = `${card.category} / ${card.title}`;
          const ariaLabel = card.description ? `${cardLabel}. ${card.description}` : cardLabel;
          const mediaContent = (
            <>
              <div class="works-index__media">
                <R2Picture
                  id={card.mediaId}
                  alt={cardLabel}
                  class="w-full h-full object-cover"
                  mediaSlot="content"
                  sizes={SIZES_BY_SPAN[card.span]}
                  eager={card.eager}
                />
              </div>

              {card.badge && (
                <div class="works-index__badge">
                  <p class="works-index__badge-primary">{card.badge.primary}</p>
                  {card.badge.secondary && (
                    <p class="works-index__badge-secondary">{card.badge.secondary}</p>
                  )}
                </div>
              )}

              <div class="works-index__overlay">
                <div class="works-index__overlay-bar">
                  {card.description && (
                    <p class="works-index__overlay-description">{card.description}</p>
                  )}
                  <div class="works-index__overlay-meta">
                    <span class="works-index__overlay-category">{card.category}</span>
                    <span aria-hidden="true">/</span>
                    <h2 class="works-index__overlay-title">{card.title}</h2>
                  </div>
                </div>
              </div>
            </>
          );

          return (
            <article
              class:list={[
                "works-index__card",
                `works-index__card--${card.span}`,
                { "works-index__card--light": card.lightSurface },
              ]}
              data-works-card={card.id}
            >
              {card.href ? (
                <a href={card.href} class="works-index__surface" aria-label={ariaLabel}>
                  {mediaContent}
                </a>
              ) : (
                <div class="works-index__surface" tabindex="0" role="group" aria-label={ariaLabel}>
                  {mediaContent}
                </div>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </main>
</Base>

<style>
.works-index {
  padding-top: clamp(7rem, 11vw, 10rem);
  padding-bottom: clamp(4.5rem, 8vw, 7.5rem);
}

.works-index__title {
  margin: 0;
  font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
  font-size: clamp(2.1rem, 3.4vw, 3.15rem);
  font-weight: 600;
  line-height: 1.02;
  letter-spacing: -0.01em;
  text-transform: uppercase;
}

.works-index__title em {
  font-style: italic;
  font-weight: 600;
}

.works-index__list {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: clamp(2rem, 3.2vw, 3rem) 1.5rem;
  padding-top: clamp(2.75rem, 4.5vw, 4rem);
}

.works-index__card {
  position: relative;
  min-width: 0;
  overflow: hidden;
  background: #dedede;
}

.works-index__card--light {
  background: #fff;
}

.works-index__card--full {
  grid-column: 1 / -1;
  aspect-ratio: 16 / 8.5;
}

.works-index__card--left-5 {
  grid-column: 1 / span 5;
  height: clamp(22rem, 36vw, 34rem);
}

.works-index__card--right-7 {
  grid-column: 6 / span 7;
  height: clamp(22rem, 36vw, 34rem);
}

.works-index__card--left-7 {
  grid-column: 1 / span 7;
  height: clamp(22rem, 36vw, 34rem);
}

.works-index__card--right-5 {
  grid-column: 8 / span 5;
  height: clamp(22rem, 36vw, 34rem);
}

.works-index__surface {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  color: inherit;
  text-decoration: none;
}

.works-index__surface:focus-visible {
  outline: 2px solid #000;
  outline-offset: -2px;
}

.works-index__media,
.works-index__media :global(picture),
.works-index__media :global(img) {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.works-index__badge {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.25rem;
  padding: 1.5rem;
  color: #fff;
  text-align: center;
  text-shadow: 0 1px 10px rgba(0, 0, 0, 0.28);
  pointer-events: none;
  transition: opacity 240ms ease;
}

.works-index__badge-primary {
  margin: 0;
  font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
  font-size: clamp(0.75rem, 1.05vw, 0.95rem);
  font-weight: 400;
  letter-spacing: 0.08em;
  line-height: 1.35;
  text-transform: uppercase;
}

.works-index__badge-secondary {
  margin: 0;
  font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
  font-size: clamp(0.75rem, 1vw, 0.9rem);
  font-weight: 400;
  letter-spacing: 0.03em;
  line-height: 1.35;
}

.works-index__overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  padding: clamp(1rem, 2.5vw, 2rem);
  background: linear-gradient(
    180deg,
    rgba(10, 10, 10, 0.68) 0%,
    rgba(10, 10, 10, 0.34) 48%,
    rgba(10, 10, 10, 0.48) 100%
  );
  color: #fff;
  opacity: 0;
  pointer-events: none;
  transition: opacity 240ms ease;
}

.works-index__overlay-bar {
  display: grid;
  width: 100%;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: start;
  gap: 0.4rem 1.25rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.85);
}

.works-index__overlay-description {
  grid-column: 1;
  margin: 0;
  max-width: 44ch;
  font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
  font-size: clamp(0.78rem, 0.92vw, 0.88rem);
  font-weight: 400;
  line-height: 1.35;
  color: rgba(255, 255, 255, 0.94);
}

.works-index__overlay-meta {
  grid-column: 2;
  display: inline-flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: flex-end;
  gap: 0.38em;
  font-family: var(--site-font-display, "Jozsika", serif);
  font-size: clamp(0.95rem, 1.25vw, 1.2rem);
  font-weight: 500;
  letter-spacing: 0.08em;
  line-height: 1.2;
  text-align: right;
  text-transform: uppercase;
}

.works-index__overlay-title {
  margin: 0;
  font-family: inherit;
  font-size: inherit;
  font-weight: inherit;
  letter-spacing: inherit;
  text-transform: inherit;
}

.works-index__surface:hover .works-index__overlay,
.works-index__surface:focus-visible .works-index__overlay,
.works-index__surface:focus-within .works-index__overlay {
  opacity: 1;
}

.works-index__surface:hover .works-index__badge,
.works-index__surface:focus-visible .works-index__badge,
.works-index__surface:focus-within .works-index__badge {
  opacity: 0;
}

@media (hover: none) {
  .works-index__overlay {
    align-items: flex-end;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 10, 0) 45%,
      rgba(10, 10, 10, 0.72) 100%
    );
    opacity: 1;
  }

  .works-index__overlay-bar {
    grid-template-columns: 1fr;
    border-bottom: 0;
    padding-bottom: 0;
  }

  .works-index__overlay-meta {
    grid-column: 1;
    justify-content: flex-start;
    text-align: left;
  }

  .works-index__overlay-description {
    display: none;
  }

  .works-index__surface:focus-visible .works-index__overlay-description,
  .works-index__surface:focus-within .works-index__overlay-description {
    display: block;
  }
}

@media (min-width: 48rem) {
  .works-index :global(.editorial-shell),
  :global(body:has(.works-index) header .editorial-shell),
  :global(body:has(.works-index) footer .editorial-shell) {
    width: 88vw;
    max-width: none;
    margin-inline: auto;
  }
}

@media (max-width: 47.99rem) {
  .works-index {
    padding-top: 6.5rem;
  }

  .works-index__title {
    font-size: clamp(2rem, 10vw, 3rem);
  }

  .works-index__list {
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding-top: 2.5rem;
  }

  .works-index__card--full,
  .works-index__card--left-5,
  .works-index__card--right-7,
  .works-index__card--left-7,
  .works-index__card--right-5 {
    grid-column: 1 / -1;
    height: auto;
    aspect-ratio: 4 / 3;
  }

  .works-index__card--full {
    aspect-ratio: 16 / 10;
  }
}

@media (prefers-reduced-motion: reduce) {
  .works-index__badge,
  .works-index__overlay {
    transition: none;
  }
}
</style>
