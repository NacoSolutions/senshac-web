---
export { getProjectPaths as getStaticPaths } from "../../../lib/static-paths";
export const prerender = true;

import { getEntry } from "astro:content";
import BlocksRenderer from "../../../components/BlocksRenderer.astro";
// src/pages/[lang]/works/[slug].astro
import Base from "../../../layouts/Base.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";

const { lang, slug } = Astro.params;

const project = await getEntry("projects", `${lang}/${slug}`);

if (!project) {
	return Astro.redirect("/404");
}

const { data } = project;
const detailsBlock = data.blocks?.find(
	(block: any) => block._template === "details",
);
const headerTitle = detailsBlock?.title || data.title;
const headerSubtitle = detailsBlock?.subtitle || data.description;
const breadcrumbs = [
	{ name: "Works", url: `/${lang}/works` },
	{ name: data.title, url: `/${lang}/works/${slug}` },
];
---

<Base
  title={data.title}
  description={data.description}
  lang={lang}
  pageChrome={data.chrome}
  pageSource={{ collection: "projects", relativePath: `${lang}/${slug}.json`, chromePath: "chrome" }}
  headerStyle="transparent"
  schema={['Article', 'BreadcrumbList']}
  breadcrumbs={breadcrumbs}
  publishDate={data.publishDate}
  aot
>
  <TinaIsland name="project" wrapper={{ tag: "main" }} params={{ relativePath: `${lang}/${slug}.json` }} primary>
    <main id="main" class="project-case-study min-h-screen pt-28 pb-16">
      <header class="project-case-study__header editorial-shell">
        <h1 class="project-case-study__title">{headerTitle}</h1>
        {headerSubtitle && (
          <p class="project-case-study__subtitle">{headerSubtitle}</p>
        )}
      </header>
      {data.blocks && data.blocks.map((block: any, index: number) => (
        <BlocksRenderer block={block} index={index} parentData={data} />
      ))}
    </main>
  </TinaIsland>
  <style is:global>
    .project-case-study__header {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-top: clamp(2rem, 5vw, 4rem);
      padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
      align-items: start;
    }

    .project-case-study__title {
      margin: 0;
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(2.25rem, 3.6vw, 3.25rem);
      font-weight: 600;
      line-height: 1.05;
    }

    .project-case-study__subtitle {
      margin: 0;
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.5rem, 2.8vw, 2.6rem);
      font-weight: 600;
      line-height: 1.15;
    }

    /* Full-bleed hero banner */
    .project-case-study > [data-block-template="media"]:first-of-type {
      width: 100vw;
      margin-left: calc(50% - 50vw);
    }

    /* Hide duplicate title/subtitle in details block (rendered in case-study header above hero) */
    .project-case-study [data-block-template="details"] > section > div > div:first-child {
      display: none;
    }

    /* Jozsika metadata */
    .project-case-study [data-block-template="details"] > section > div > div:nth-child(2) {
      font-family: var(--site-font-display, "Jozsika", serif);
      font-size: clamp(1rem, 1.35vw, 1.25rem);
      font-weight: 400;
    }

    .project-case-study [data-block-template="details"] > section > div > div:nth-child(2) p:last-child {
      font-family: var(--site-font-display, "Jozsika", serif);
      font-size: clamp(1rem, 1.35vw, 1.25rem);
      font-weight: 400;
    }

    /* Clean editorial sections */
    .project-case-study [data-block-template="text"] > section,
    .project-case-study [data-block-template="credits"] > section {
      background-color: transparent;
    }

    .project-case-study [data-block-template="text"] > section > h2,
    .project-case-study [data-block-template="credits"] > section > div > h2 {
      margin: 0 0 1.25rem;
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.125rem, 1.5vw, 1.5rem);
      font-weight: 600;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .project-case-study [data-block-template="text"] > section > div {
      margin: 0;
      font-family: var(--site-font-body, "Sinteca", system-ui, sans-serif);
      font-size: clamp(1.05rem, 1.35vw, 1.35rem);
      line-height: 1.45;
      color: var(--color-text-primary, rgba(18, 18, 18, 0.85));
    }

    /* 2-column photo pairs */
    .project-case-study [data-block-template="gallery"] > section > div {
      gap: 1.5rem;
    }

    .project-case-study [data-block-template="gallery"] img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    @media (min-width: 768px) {
      .project-case-study .editorial-shell,
      .project-case-study [data-block-template="details"] > section > div,
      .project-case-study [data-block-template="text"] > section,
      .project-case-study [data-block-template="gallery"] > section,
      .project-case-study [data-block-template="credits"] > section > div,
      .project-case-study [data-block-template="media"]:not(:first-of-type) > div {
        width: 88vw;
        max-width: none;
        margin-inline: auto;
        padding-inline: 0;
      }

      .project-case-study [data-block-template="gallery"] > section > div {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (min-width: 1024px) {
      /* Header: col 2-4 title + col 6-12 subtitle */
      .project-case-study__header {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
      }

      .project-case-study__title {
        grid-column: 2 / 5;
      }

      .project-case-study__subtitle {
        grid-column: 6 / 13;
      }

      /* Details metadata in col 6-12, detail image spans col 1-12 */
      .project-case-study [data-block-template="details"] > section > div {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
      }

      .project-case-study [data-block-template="details"] > section > div > div:nth-child(2) {
        grid-column: 6 / 13;
      }

      .project-case-study [data-block-template="details"] > section > div > div:nth-child(3) {
        grid-column: 1 / -1;
      }

      /* Editorial text & credits: col 2-4 subheading + col 6-12 Sinteca body */
      .project-case-study [data-block-template="text"] > section,
      .project-case-study [data-block-template="credits"] > section > div {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 1.5rem;
        align-items: start;
      }

      .project-case-study [data-block-template="text"] > section > h2,
      .project-case-study [data-block-template="credits"] > section > div > h2 {
        grid-column: 2 / 5;
        margin-bottom: 0;
      }

      .project-case-study [data-block-template="text"] > section > div,
      .project-case-study [data-block-template="credits"] > section > div > div {
        grid-column: 6 / 13;
      }
    }
  </style>
</Base>
