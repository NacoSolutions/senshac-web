# Tina has one canonical, non-localized entry point. The generated admin
# bundle is a concrete static asset because Pages SSR workers do not reliably
# resolve directory indexes. Middleware repeats these redirects for worker
# requests.
/admin /admin/index.html 302
/admin/ /admin/index.html 302
/es/admin /admin/index.html 302
/es/admin/ /admin/index.html 302
