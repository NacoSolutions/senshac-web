{
  "name": "senshac",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev:cms": "tinacms dev -c \"astro dev\"",
    "tina:generate": "if ( [ -n \"$TINA_CLIENT_ID\" ] || [ -n \"$NEXT_PUBLIC_TINA_CLIENT_ID\" ] ) && [ -n \"$TINA_TOKEN\" ]; then tinacms build --skip-cloud-checks; else tinacms build --local --skip-cloud-checks; fi && node scripts/normalize-tina-admin.mjs",
    "build": "node scripts/sync-editorial-content.mjs && if ( [ -n \"$TINA_CLIENT_ID\" ] || [ -n \"$NEXT_PUBLIC_TINA_CLIENT_ID\" ] ) && [ -n \"$TINA_TOKEN\" ]; then tinacms build --skip-cloud-checks; else tinacms build --local --skip-cloud-checks; fi && astro build && node scripts/normalize-pages-wrangler.mjs && node scripts/normalize-tina-admin.mjs public dist",
    "verify:ci": "CF_PAGES=1 bun run build && bun run acceptance --skip-build && bun run check:all && git diff --exit-code",
    "deploy": "bash scripts/deploy",
    "wt:merge": "bash scripts/wt-merge",
    "wt:doctor": "bash scripts/wt-doctor",
    "wt:cleanup": "bash scripts/wt-cleanup",
    "maintenance:prune": "bun run scripts/ci/prune-pages.ts",
    "media:image": "bash scripts/media-container images",
    "media:font": "bash scripts/media-container font",
    "media:object": "bash scripts/media-container object",
    "media:stage:redesign": "bun scripts/media/stage-redesign-media.ts",
    "media:upload": "bash scripts/media-container upload",
    "media:verify": "bash scripts/media-container verify-r2",
    "media:video": "bash scripts/media-container video",
    "test:workflow:media": "bash scripts/act-media",
    "test:workflow:ci": "bash scripts/act-ci",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "biome check --write .",
    "check:deps": "bash scripts/with-timeout 120 knip",
    "check:precommit": "CHECK_CLEAN_ALLOW_STAGED=1 bun run check:clean && bun run lint && bun run check:seeds",
    "check:prepush": "rm -rf node_modules && bun install --frozen-lockfile && bun run verify:ci",
    "check:all": "bun run check:clean && bun run check && bun run lint && bun run check:deps && bun run check:coverage && bun run check:debt-markers && bun run check:file-sizes && bun run check:bundle-size && bun run check:worker-size && bun run check:ci-parity && bun run gen:docs:check && bun run gen:openapi:check && bun run check:secrets-policy && bun run check:seeds && bun run check:agents && bun run check:leaks",
    "check:agents": "bun run scripts/validate-agents-md.ts",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "acceptance": "bun run scripts/acceptance/run.ts",
    "acceptance:container": "bun run scripts/acceptance/run.ts --mode container",
    "test:coverage": "bun test src/ scripts/ --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "check:coverage": "bun run scripts/check-coverage.ts",
    "check:bundle-size": "bun run scripts/check-bundle-size.ts",
    "check:worker-size": "bun run scripts/check-worker-size.ts",
    "check:pages-routing": "bun run scripts/check-pages-routing.ts",
    "check:file-sizes": "bun run scripts/check-file-sizes.ts",
    "check:debt-markers": "bun run scripts/check-debt-markers.ts",
    "report:test-timing": "bun run scripts/report-test-timing.ts",
    "report:quality-metrics": "bun run scripts/report-quality-metrics.ts",
    "gen:docs": "bun run scripts/generate-docs.ts",
    "gen:docs:check": "bun run scripts/generate-docs.ts --check",
    "gen:openapi": "bun run scripts/generate-openapi.ts",
    "gen:openapi:check": "bun run scripts/generate-openapi.ts --check",
    "check:ci-parity": "bun run scripts/check-ci-parity.ts",
    "clean": "rm -rf coverage/ playwright-report/ test-results/ && find . -type d -empty -not -path \"./.git/*\" -not -path \"./node_modules/*\" -delete",
    "check:clean": "bun run scripts/check-repo-cleanliness.ts",
    "check:seeds": "bun run scripts/seeds-integrity.ts",
    "check:secrets-policy": "bun run scripts/check-secret-policy.ts",
    "test:secrets:sops": "bash scripts/sops-age-smoke",
    "check:leaks": "betterleaks git --redact --no-banner --no-color .",
    "typecheck": "node scripts/typecheck.mjs",
    "preview:check": "node scripts/preview-check.mjs",
    "check:admin-routing": "node scripts/admin-routing-check.mjs",
    "repository:check": "node scripts/repository-check.mjs",
    "quality": "npm run lint && npm test && npm run tina:generate && npm run typecheck && npm run build && npm run check:admin-routing && npm run preview:check && npm run repository:check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/mdx": "^6.0.3",
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0",
    "@tinacms/astro": "^0.5.0",
    "@tinacms/auth": "^1.1.3",
    "@unocss/astro": "^66.5.10",
    "@unocss/preset-wind4": "^66.7.0",
    "@unocss/preset-icons": "66.7.0",
    "@unocss/transformer-directives": "^66.5.10",
    "alpinejs": "^3.15.3",
    "astro": "^6.4.6",
    "esbuild": "^0.28.1",
    "hls.js": "^1.6.16",
    "htmx.org": "^2.0.8",
    "next-tinacms-s3": "24.0.3",
    "node-html-markdown": "^2.0.0",
    "unocss": "^66.5.10",
    "vite": "^8.0.16",
    "yaml": "^2.9.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ],
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@iconify-json/lucide": "1.2.31",
    "@iconify-json/simple-icons": "1.2.36",
    "@playwright/test": "^1.60.0",
    "@tinacms/cli": "3.0.0",
    "@types/alpinejs": "^3.13.11",
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "bun-types": "^1.3.14",
    "happy-dom": "^20.10.2",
    "js-yaml": "^4.2.0",
    "tinacms": "3.14.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "yaml": "^2.9.0",
    "vite": "^8.0.16",
    "esbuild": "^0.28.0",
    "js-cookie": "^3.0.8",
    "undici": "^8.4.1",
    "ws": "^8.21.0"
  }
}
