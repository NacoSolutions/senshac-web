{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Senshac home content contract",
  "type": "object",
  "required": ["home"],
  "properties": {
    "home": {
      "type": "object",
      "required": ["title", "intro"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "intro": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
